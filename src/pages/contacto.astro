---
// Contacto page - Contact with social media integration
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto - Escuela Ul-ji Taekwondo">
  <main class="min-h-screen bg-white dark:bg-gray-900">
    
    <!-- Hero Section -->
    <section class="bg-gradient-primary dark:from-ulji-green-800 dark:to-brand-blue py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Contacto
        </h1>
        <p class="text-xl text-ulji-green-light max-w-2xl mx-auto">
          Conecta con nosotros a través de múltiples canales y únete a nuestra comunidad
        </p>
      </div>
    </section>

    <!-- Quick Contact Buttons -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Contacto Rápido
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Elige tu canal preferido para comunicarte con nosotros
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          <!-- WhatsApp -->
          <a 
            href="https://wa.me/34666123456" 
            target="_blank"
            class="group bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 rounded-xl p-8 text-center hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-green-400"
          >
            <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.485 3.488"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">WhatsApp</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Respuesta inmediata para consultas rápidas y dudas
            </p>
            <div class="text-green-600 dark:text-green-400 font-semibold">
              +34 666 123 456
            </div>
          </a>

          <!-- Instagram -->
          <a 
            href="https://instagram.com/escuelaulji" 
            target="_blank"
            class="group bg-gradient-to-br from-pink-50 to-purple-100 dark:from-pink-900/20 dark:to-purple-800/20 rounded-xl p-8 text-center hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-pink-400"
          >
            <div class="w-20 h-20 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.739.099.120.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.750-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001.012.001z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Instagram</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Síguenos para ver fotos, videos y novedades diarias
            </p>
            <div class="text-pink-600 dark:text-pink-400 font-semibold">
              @escuelaulji
            </div>
          </a>

          <!-- Facebook -->
          <a 
            href="https://facebook.com/escuelaulji" 
            target="_blank"
            class="group bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 rounded-xl p-8 text-center hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-blue-400"
          >
            <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Facebook</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Únete a nuestra comunidad y comparte experiencias
            </p>
            <div class="text-blue-600 dark:text-blue-400 font-semibold">
              Escuela Ul-ji Taekwondo
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Form and Info -->
    <section class="py-16 bg-gray-50 dark:bg-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          
          <!-- Contact Form -->
          <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg p-8">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
              Envíanos un Mensaje
            </h3>
            
            <form class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Nombre *
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-brand-red focus:border-transparent transition-colors duration-300"
                    placeholder="Tu nombre completo"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Teléfono *
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-brand-red focus:border-transparent transition-colors duration-300"
                    placeholder="+34 123 456 789"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Email *
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-brand-red focus:border-transparent transition-colors duration-300"
                  placeholder="tu@email.com"
                />
              </div>

              <div>
                <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Asunto
                </label>
                <select 
                  id="subject" 
                  name="subject"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-brand-red focus:border-transparent transition-colors duration-300"
                >
                  <option value="">Selecciona un asunto</option>
                  <option value="clase-prueba">Clase de Prueba Gratis</option>
                  <option value="informacion">Información General</option>
                  <option value="horarios">Consulta sobre Horarios</option>
                  <option value="precios">Precios y Tarifas</option>
                  <option value="competicion">Equipo de Competición</option>
                  <option value="eventos">Eventos y Exámenes</option>
                  <option value="otro">Otro</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Mensaje *
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5"
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-brand-red focus:border-transparent transition-colors duration-300 resize-none"
                  placeholder="Cuéntanos cómo podemos ayudarte..."
                ></textarea>
              </div>

              <div>
                <label class="flex items-start">
                  <input 
                    type="checkbox" 
                    class="mt-1 w-4 h-4 text-brand-red bg-gray-100 border-gray-300 rounded focus:ring-brand-red dark:focus:ring-ulji-red-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                    required
                  />
                  <span class="ml-3 text-sm text-gray-600 dark:text-gray-400">
                    Acepto la <a href="#" class="text-brand-red dark:text-ulji-red-400 hover:underline">política de privacidad</a> y autorizo el tratamiento de mis datos personales.
                  </span>
                </label>
              </div>

              <button 
                type="submit"
                class="w-full bg-gradient-primary hover:opacity-90 dark:bg-ulji-red-500 dark:hover:bg-ulji-red-600 text-white py-3 px-6 rounded-lg font-semibold transition-all duration-300 focus:ring-2 focus:ring-brand-red focus:ring-offset-2 dark:focus:ring-offset-gray-900"
              >
                Enviar Mensaje
              </button>
            </form>
          </div>

          <!-- Contact Information -->
          <div class="space-y-8">
            <!-- Location -->
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg p-8">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
                Nuestra Ubicación
              </h3>
              
              <div class="space-y-4">
                <div class="flex items-start">
                  <svg class="w-6 h-6 text-brand-red mr-4 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <h4 class="font-semibold text-gray-900 dark:text-white">Dirección</h4>
                    <p class="text-gray-600 dark:text-gray-400">
                      Calle del Dojang, 123<br>
                      28001 Madrid, España
                    </p>
                  </div>
                </div>

                <div class="flex items-start">
                  <svg class="w-6 h-6 text-brand-red mr-4 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <div>
                    <h4 class="font-semibold text-gray-900 dark:text-white">Teléfono</h4>
                    <p class="text-gray-600 dark:text-gray-400">
                      +34 91 123 45 67
                    </p>
                  </div>
                </div>

                <div class="flex items-start">
                  <svg class="w-6 h-6 text-brand-red mr-4 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <div>
                    <h4 class="font-semibold text-gray-900 dark:text-white">Email</h4>
                    <p class="text-gray-600 dark:text-gray-400">
                      info@escuelaulji.com
                    </p>
                  </div>
                </div>
              </div>

              <!-- Map placeholder -->
              <div class="mt-6 h-48 bg-gray-200 dark:bg-gray-700 rounded-lg flex items-center justify-center">
                <div class="text-center">
                  <svg class="w-12 h-12 text-gray-400 dark:text-gray-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <p class="text-gray-500 dark:text-gray-400 text-sm">Mapa Interactivo</p>
                </div>
              </div>
            </div>

            <!-- Schedule -->
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg p-8">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
                Horarios de Atención
              </h3>
              
              <div class="space-y-3">
                <div class="flex justify-between items-center py-2 border-b border-gray-200 dark:border-gray-700">
                  <span class="font-medium text-gray-900 dark:text-white">Lunes - Viernes</span>
                  <span class="text-gray-600 dark:text-gray-400">17:00 - 22:00</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-200 dark:border-gray-700">
                  <span class="font-medium text-gray-900 dark:text-white">Sábados</span>
                  <span class="text-gray-600 dark:text-gray-400">09:00 - 14:00</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="font-medium text-gray-900 dark:text-white">Domingos</span>
                  <span class="text-gray-600 dark:text-gray-400">Cerrado</span>
                </div>
              </div>

              <div class="mt-6 p-4 bg-ulji-red-50 dark:bg-ulji-red-900/20 rounded-lg">
                <p class="text-sm text-brand-red dark:text-ulji-red-400">
                  <strong>Nota:</strong> Los horarios pueden variar durante festividades y eventos especiales. 
                  Consulta nuestras redes sociales para actualizaciones.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Additional Contact Methods -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
            Más Formas de Contactarnos
          </h2>
          <div class="w-24 h-1 bg-red-600 mx-auto mb-8"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- YouTube -->
          <div class="text-center">
            <a 
              href="https://youtube.com/@escuelaulji" 
              target="_blank"
              class="group block"
            >
              <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-red-700 transition-colors duration-300">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </div>
              <h4 class="font-bold text-gray-900 dark:text-white mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">YouTube</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Tutoriales y videos</p>
            </a>
          </div>

          <!-- Twitter -->
          <div class="text-center">
            <a 
              href="https://twitter.com/escuelaulji" 
              target="_blank"
              class="group block"
            >
              <div class="w-16 h-16 bg-blue-400 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-500 transition-colors duration-300">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              </div>
              <h4 class="font-bold text-gray-900 dark:text-white mb-2 group-hover:text-blue-500 transition-colors duration-300">Twitter</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Noticias y updates</p>
            </a>
          </div>

          <!-- TikTok -->
          <div class="text-center">
            <a 
              href="https://tiktok.com/@escuelaulji" 
              target="_blank"
              class="group block"
            >
              <div class="w-16 h-16 bg-black rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-gray-800 transition-colors duration-300">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              </div>
              <h4 class="font-bold text-gray-900 dark:text-white mb-2 group-hover:text-gray-800 transition-colors duration-300">TikTok</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Videos cortos</p>
            </a>
