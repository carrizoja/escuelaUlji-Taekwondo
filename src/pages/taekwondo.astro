---
// Taekwondo page - History, Titles, and FAQs
import Layout from "../layouts/Layout.astro";
import History from "../components/blocks/History.astro";
import Grades from "../components/blocks/Grades.astro";
import Faqs from "../components/blocks/Faqs.astro";
import ThirdButton from "../components/ui/ThirdButton.astro";
import SchoolTime from "../components/blocks/SchoolTime.astro";
---

<Layout 
	title="Taekwondo - Historia y Filosofía | Escuela Ul-ji"
	description="Descubre la historia del Taekwondo, sistema de cinturones, graduaciones y la filosofía marcial. Información completa sobre este arte marcial coreano en la Escuela Ul-ji."
	keywords="historia taekwondo, cinturones taekwondo, graduaciones, filosofía marcial, arte marcial coreano, sistema de grados, Escuela Ul-ji, Dan, Gup"
>
  <main class="min-h-screen bg-white dark:bg-gray-900">
    <!-- Hero Section -->
    <section class="bg-gradient-primary dark:bg-gradient-dark py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Taekwon-do
        </h1>
        <p class="text-xl text-ulji-red-100 max-w-2xl mx-auto">
          Descubrí la historia, técnicas y filosofía del arte marcial surcoreano
        </p>
      </div>
    </section>

    <!-- Navigation Tabs -->
    <section class="bg-white dark:bg-gray-800 shadow-lg sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex space-x-8 overflow-x-auto py-4">
          <a
            href="#historia"
            class="whitespace-nowrap text-brand-red dark:text-ulji-red-400 border-b-2 border-brand-red dark:border-ulji-red-400 px-4 py-2 font-semibold"
          >
            Historia
          </a>
          <a
            href="#titulos"
            class="whitespace-nowrap text-gray-600 dark:text-gray-400 hover:text-brand-red dark:hover:text-ulji-red-400 px-4 py-2 font-semibold transition-colors duration-300"
          >
            Títulos
          </a>
          <a
            href="#faqs"
            class="whitespace-nowrap text-gray-600 dark:text-gray-400 hover:text-brand-red dark:hover:text-ulji-red-400 px-4 py-2 font-semibold transition-colors duration-300"
          >
            FAQs
          </a>
        </nav>
      </div>
    </section>

    <!-- Historia Section -->
    <History />
    <SchoolTime />

    <!-- Títulos Section -->
    <Grades />
  </main>

  <!-- FAQs Section -->
  <Faqs />

  <!-- Call to Action -->
  <section class="py-16 bg-gradient-primary dark:bg-ulji-red-700">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h3 class="text-3xl font-bold text-white mb-6">
        Estudiá con nuestro material teórico
      </h3>
      <p class="text-xl text-white mb-8">
        Descargá el manual con todo lo necesario para tu formación en Taekwon-do
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <ThirdButton
          href="/docs/teorico.pdf"
          download="Manual_Taekwondo_Escuela_Ul-ji.pdf"
          variant="primary"
          icon={true}
        >
          Descargar PDF
        </ThirdButton>
        <ThirdButton
          href="/eventos"
          variant="outline"
        >
          Ver Próximos Eventos
        </ThirdButton>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Smooth scrolling for navigation links
  document.addEventListener("DOMContentLoaded", function () {
    const navLinks = document.querySelectorAll('nav a[href^="#"]');

    navLinks.forEach((link) => {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        if (!(e.currentTarget instanceof HTMLElement)) return;

        const currentLink = e.currentTarget;
        const targetId = currentLink.getAttribute("href")?.substring(1);
        const targetElement = targetId
          ? document.getElementById(targetId)
          : null;

        if (targetElement instanceof HTMLElement) {
          const offsetTop = targetElement.offsetTop - 100;

          window.scrollTo({
            top: offsetTop,
            behavior: "smooth",
          });

          // Update active nav item
          navLinks.forEach((navLink) => {
            if (navLink instanceof HTMLElement) {
              navLink.classList.remove(
                "text-brand-red",
                "dark:text-ulji-red-400",
                "border-b-2",
                "border-brand-red",
                "dark:border-ulji-red-400"
              );
              navLink.classList.add("text-gray-600", "dark:text-gray-400");
            }
          });

          currentLink.classList.add(
            "text-brand-red",
            "dark:text-ulji-red-400",
            "border-b-2",
            "border-brand-red",
            "dark:border-ulji-red-400"
          );
          currentLink.classList.remove("text-gray-600", "dark:text-gray-400");
        }
      });
    });
  });
</script>
