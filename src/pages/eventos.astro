---
// Eventos page - Exams, Tournaments, and Meetings
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import BeltStripe from '../components/BeltStripe.astro';
import PrimaryButton from '../components/ui/PrimaryButton.astro';
import { WATERMARKS } from '../utils/watermark.js';
import { fetchEventData, formatDate, isUpcoming, isPastDate } from '../utils/googleSheets.js';
import { getMainDojang, getWhatsAppLink } from '../data/dojangs.js';
import { buildRegistrationMessage } from '../utils/eventRegistration.js';

const mainDojang = getMainDojang();
const registrationLink = (name, fecha) =>
  getWhatsAppLink(mainDojang, buildRegistrationMessage({ name, date: formatDate(fecha) }));

// Get configuration from environment variables
const SHEET_ID = import.meta.env.PUBLIC_GOOGLE_SHEETS_ID_EVENTOS || import.meta.env.GOOGLE_SHEETS_ID_EVENTOS || '1koYz8Tvd6oEMFB8nBsVQIpNeIYS1dBmrL8jRdSrI_kg';
const API_KEY = import.meta.env.PUBLIC_GOOGLE_API_KEY || import.meta.env.GOOGLE_API_KEY;

// Fetch data at build time
let eventData;
try {
  eventData = await fetchEventData(SHEET_ID, API_KEY);
  console.log('Fetched event data:', {
    examenes: eventData.examenes.length,
    torneos: eventData.torneos.length,
    seminarios: eventData.seminarios.length
  });
} catch (error) {
  // Fail the production build rather than deploy an empty events page
  if (import.meta.env.PROD) throw error;
  console.error('Failed to fetch event data:', error);
  eventData = { examenes: [], torneos: [], seminarios: [] };
}

const { examenes, torneos, seminarios } = eventData;

// Update exam status based on date
const updatedExamenes = examenes.map(examen => {
  // If the exam date is in the past and status is "Programado", change to "Finalizado"
  if (isPastDate(examen.fecha) && examen.estado === 'Programado') {
    return { ...examen, estado: 'Finalizado' };
  }
  return examen;
});

// Update tournament status based on date
const updatedTorneos = torneos.map(torneo => {
  // If the tournament date is in the past and status is "Inscripciones Abiertas", change to "Finalizado"
  if (isPastDate(torneo.fecha) && torneo.estado === 'Inscripciones Abiertas') {
    return { ...torneo, estado: 'Finalizado' };
  }
  // Also check for "Inscripciones abiertas" (lowercase 'a')
  if (isPastDate(torneo.fecha) && torneo.estado === 'Inscripciones abiertas') {
    return { ...torneo, estado: 'Finalizado' };
  }
  return torneo;
});

// Update seminario status based on date (similar to exams and tournaments)
const updatedSeminarios = seminarios.map(seminario => {
  // If the seminario date is in the past, we'll handle the registration button separately
  // but we can track if it's past for UI purposes
  return { ...seminario, isPast: isPastDate(seminario.fecha) };
});

// Filter upcoming events (use updated examenes, torneos, and seminarios)
const upcomingExamenes = updatedExamenes.filter(exam => isUpcoming(exam.fecha));
const upcomingTorneos = updatedTorneos.filter(torneo => isUpcoming(torneo.fecha));
const upcomingSeminarios = updatedSeminarios.filter(seminario => isUpcoming(seminario.fecha));

// If no upcoming events, fall back to showing all events
const displayExamenes = upcomingExamenes.length > 0 ? upcomingExamenes : updatedExamenes;
const displayTorneos = upcomingTorneos.length > 0 ? upcomingTorneos : updatedTorneos;
const displaySeminarios = upcomingSeminarios.length > 0 ? upcomingSeminarios : updatedSeminarios;

---

<Layout 
	title="Eventos - Exámenes, Torneos y Seminarios | Escuela Ul-ji"
	description="Mantente actualizado con todos los eventos de la Escuela Ul-ji: exámenes de graduación, torneos de competición, seminarios especiales y actividades familiares."
	keywords="eventos taekwondo, exámenes graduación, torneos competición, seminarios, actividades familiares, calendario eventos, inscripciones, Escuela Ul-ji"
>
  <main class="min-h-screen">
    
    <!-- Hero (dark tone) -->
    <Section tone="dark" class="py-20" watermark={WATERMARKS.events} watermarkPosition="top-left">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span aria-hidden="true" class="mb-4 block h-1 w-10 bg-brand-red"></span>
        <h1 class="heading text-4xl md:text-6xl mb-6">
          Eventos
        </h1>
        <p class="text-xl font-text text-muted max-w-2xl">
          Participá en exámenes, torneos y encuentros especiales de nuestra comunidad
        </p>
      </div>
    </Section>
    <BeltStripe />

    <!-- Navigation Tabs -->
    <div class="tone-dark sticky top-20 z-40 border-b border-line !bg-surface shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex space-x-8 overflow-x-auto py-4">
          <button data-tab="examenes" class="tab-button whitespace-nowrap text-eyebrow border-b-2 border-eyebrow px-4 py-2 font-heading font-semibold">
            Exámenes ({displayExamenes.length})
          </button>
          <button data-tab="torneos" class="tab-button whitespace-nowrap text-muted hover:text-eyebrow px-4 py-2 font-heading font-semibold transition-colors duration-300">
            Torneos ({displayTorneos.length})
          </button>
          <button data-tab="seminarios" class="tab-button whitespace-nowrap text-muted hover:text-eyebrow px-4 py-2 font-heading font-semibold transition-colors duration-300">
            Seminarios ({displaySeminarios.length})
          </button>
        </nav>
      </div>
    </div>

    <!-- Exámenes Section -->
    <Section tone="dark" id="examenes" class="tab-content py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="heading text-3xl md:text-4xl mb-6">
            Próximos Exámenes de Grado
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg font-text text-muted max-w-3xl mx-auto">
            Evalúa tu progreso y avanza al siguiente nivel en tu entrenamiento de Taekwon-do
          </p>
        </div>

        {displayExamenes.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {displayExamenes.map((examen) => (
              <div class="rounded-xl border border-line bg-card shadow-lg p-6 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-xl font-heading font-bold text-fg">{examen.tipo}</h3>
                  <span class="text-sm border border-line bg-bg text-fg px-3 py-1 rounded-full font-medium">
                    {formatDate(examen.fecha)}
                  </span>
                </div>
                
                <div class="space-y-3 text-muted">
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-brand-red mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="font-text font-medium">{examen.grado}</span>
                  </div>
                  
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-text">{examen.lugar}</span>
                  </div>
                  
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-text">{examen.hora}</span>
                  </div>
                </div>
                
                {examen.requisitos && (
                  <div class="mt-4 p-3 bg-bg rounded-lg">
                    <p class="text-sm font-text text-fg">
                      <strong>Requisitos:</strong> {examen.requisitos}
                    </p>
                  </div>
                )}

                {examen.estado && (
                  <div class="mt-4">
                    <span class={`inline-block px-3 py-1 rounded-full text-sm font-semibold ${
                      examen.estado === 'Abierto' ? 'border border-status text-status' :
                      examen.estado === 'Próximamente' ? 'border border-line text-fg' :
                      'border border-line text-muted'
                    }`}>
                      {examen.estado}
                    </span>
                  </div>
                )}
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-muted mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <h3 class="text-lg font-heading font-semibold text-fg mb-2">No hay exámenes programados</h3>
            <p class="font-text text-muted">Los próximos exámenes se anunciarán pronto.</p>
          </div>
        )}
      </div>
    </Section>

    <!-- Torneos Section -->
    <Section tone="dark" id="torneos" class="tab-content hidden py-16 !bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="heading text-3xl md:text-4xl mb-6">
            Torneos y Competencias
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg font-text text-muted max-w-3xl mx-auto">
            Compite y demuestra tus habilidades en torneos locales, nacionales e internacionales
          </p>
        </div>

        {displayTorneos.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {displayTorneos.map((torneo) => (
              <div class="rounded-xl border border-line bg-card shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-6">
                  <div>
                    <h3 class="text-2xl font-heading font-bold text-fg mb-2">{torneo.nombre}</h3>
                    <p class="text-eyebrow font-heading font-semibold">{torneo.categoria}</p>
                  </div>
                  <span class="bg-brand-red text-white px-4 py-2 rounded-lg font-heading font-bold text-lg">
                    {formatDate(torneo.fecha)}
                  </span>
                </div>
                
                <div class="space-y-4 mb-6">
                  <div class="flex items-center text-muted">
                    <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-text">{torneo.lugar}</span>
                  </div>
                  
                  <div class="flex items-center text-muted">
                    <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="font-text">Inscripción: {torneo.inscripcion}</span>
                  </div>
                  
                  {torneo.costo && (
                    <div class="flex items-center text-muted">
                      <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                      </svg>
                      <span class="font-text">Costo: {torneo.costo}</span>
                    </div>
                  )}

                  {torneo.premio && (
                    <div class="flex items-center text-muted">
                      <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 2L3 9h4v9h6v-9h4l-7-7z" clip-rule="evenodd"></path>
                      </svg>
                      <span class="font-text">Premio: {torneo.premio}</span>
                    </div>
                  )}
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                  <div class="text-center p-3 bg-bg rounded-lg">
                    <div class="text-sm font-text text-muted">Nivel</div>
                    <div class="font-heading font-semibold text-fg">{torneo.nivel}</div>
                  </div>
                  {torneo.modalidad && (
                    <div class="text-center p-3 bg-bg rounded-lg">
                      <div class="text-sm font-text text-muted">Modalidad</div>
                      <div class="font-heading font-semibold text-fg">{torneo.modalidad}</div>
                    </div>
                  )}
                </div>

                {torneo.estado && (
                  <div class="flex justify-between items-center">
                    <span class={`inline-block px-4 py-2 rounded-full text-sm font-heading font-semibold ${
                      torneo.estado === 'Inscripciones Abiertas' ? 'border border-status text-status' :
                      torneo.estado === 'Próximamente' ? 'border border-line text-fg' :
                      'border border-line text-muted'
                    }`}>
                      {torneo.estado}
                    </span>
                    {/* Only show "Inscribirse" button if tournament is not finished */}
                    {torneo.estado !== 'Finalizado' && !isPastDate(torneo.fecha) && (
                      <PrimaryButton text="Inscribirse" size="sm" icon="arrow" href={registrationLink(torneo.nombre, torneo.fecha)} target="_blank" />
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-muted mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            <h3 class="text-lg font-heading font-semibold text-fg mb-2">No hay torneos programados</h3>
            <p class="font-text text-muted">Los próximos torneos se anunciarán pronto.</p>
          </div>
        )}
      </div>
    </Section>

    <!-- Seminarios Section -->
    <Section tone="dark" id="seminarios" class="tab-content hidden py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="heading text-3xl md:text-4xl mb-6">
            Seminarios y Encuentros
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg font-text text-muted max-w-3xl mx-auto">
            Eventos especiales con grandes maestros y actividades de la comunidad
          </p>
        </div>

        {displaySeminarios.length > 0 ? (
          <div class="space-y-6">
            {displaySeminarios.map((seminario) => (
              <div class="rounded-xl border border-line bg-card shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                  <div class="flex-1">
                    <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-brand-red rounded-full flex items-center justify-center mr-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                      </div>
                      <div>
                        <h3 class="text-2xl font-heading font-bold text-fg">{seminario.titulo}</h3>
                        <p class="text-eyebrow font-heading font-semibold">Con {seminario.maestro}</p>
                      </div>
                    </div>
                    
                    <p class="font-text text-muted mb-4 text-lg">{seminario.tema}</p>
                    
                    {seminario.descripcion && (
                      <p class="font-text text-muted mb-4">{seminario.descripcion}</p>
                    )}
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm font-text text-muted mb-4">
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                        </svg>
                        {seminario.duracion}
                      </div>
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                        </svg>
                        {seminario.costo}
                      </div>
                      {seminario.cupos && (
                        <div class="flex items-center">
                          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"></path>
                          </svg>
                          {seminario.cupos}
                        </div>
                      )}
                      {seminario.nivel && (
                        <div class="flex items-center">
                          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                          </svg>
                          {seminario.nivel}
                        </div>
                      )}
                    </div>

                    {seminario.lugar && (
                      <div class="flex items-center text-muted">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span class="font-text">{seminario.lugar}</span>
                      </div>
                    )}
                  </div>
                  
                  <div class="mt-6 lg:mt-0 lg:ml-8">
                    <div class="text-center">
                      <div class={`px-6 py-3 rounded-lg font-heading font-bold text-xl mb-4 ${
                        isPastDate(seminario.fecha) ? 'bg-line text-muted' : 'bg-brand-red text-white'
                      }`}>
                        {formatDate(seminario.fecha)}
                      </div>
                      {!isPastDate(seminario.fecha) && (
                        <PrimaryButton text="Inscribirse" size="sm" icon="arrow" variant="outline" href={registrationLink(seminario.titulo, seminario.fecha)} target="_blank" />
                      )}
                      {isPastDate(seminario.fecha) && (
                        <div class="text-muted font-heading font-semibold px-6 py-2">
                          Evento Finalizado
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-muted mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <h3 class="text-lg font-heading font-semibold text-fg mb-2">No hay seminarios programados</h3>
            <p class="font-text text-muted">Los próximos seminarios se anunciarán pronto.</p>
          </div>
        )}
      </div>
    </Section>

  </main>
</Layout>

<script>
  // Tab functionality
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    function switchTab(targetTab: string): void {
      // Update buttons
      tabButtons.forEach(button => {
        const buttonElement = button as HTMLElement;
        const tabValue = buttonElement.getAttribute('data-tab');
        const isActive = tabValue === targetTab;
        
        if (isActive) {
          buttonElement.classList.remove('text-muted');
          buttonElement.classList.add('text-eyebrow', 'border-b-2', 'border-eyebrow');
        } else {
          buttonElement.classList.remove('text-eyebrow', 'border-b-2', 'border-eyebrow');
          buttonElement.classList.add('text-muted');
        }
      });

      // Update content
      tabContents.forEach(content => {
        const isActive = content.id === targetTab;
        content.classList.toggle('hidden', !isActive);
      });
    }

    // Add click event listeners to tab buttons
    tabButtons.forEach(button => {
      button.addEventListener('click', (e: Event) => {
        const target = e.currentTarget;
        if (target instanceof HTMLElement) {
          const tabValue = target.getAttribute('data-tab');
          if (tabValue) {
            switchTab(tabValue);
          }
        }
      });
    });

    // Set initial tab (examenes by default)
    switchTab('examenes');
  });
</script>
