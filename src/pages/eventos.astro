---
// Eventos page - Exams, Tournaments, and Meetings
import Layout from '../layouts/Layout.astro';
import { fetchEventData, formatDate, isUpcoming, isPastDate } from '../utils/googleSheets';

// Get configuration from environment variables
const SHEET_ID = import.meta.env.GOOGLE_SHEETS_ID || import.meta.env.PUBLIC_GOOGLE_SHEETS_ID;
const API_KEY = import.meta.env.GOOGLE_API_KEY;

// Fetch data at build time
let eventData;
try {
  console.log('Fetching event data from Google Sheets...');
  eventData = await fetchEventData(SHEET_ID, API_KEY);
  console.log('Successfully fetched event data:', {
    examenes: eventData.examenes.length,
    torneos: eventData.torneos.length,
    seminarios: eventData.seminarios.length
  });
  
  // Debug the actual data
  console.log('Raw data sample:');
  if (eventData.examenes.length > 0) {
    console.log('First examen:', eventData.examenes[0]);
  }
  if (eventData.torneos.length > 0) {
    console.log('First torneo:', eventData.torneos[0]);
  }
  if (eventData.seminarios.length > 0) {
    console.log('First seminario:', eventData.seminarios[0]);
  }
} catch (error) {
  console.error('Failed to fetch event data:', error);
  eventData = { examenes: [], torneos: [], seminarios: [] };
}

const { examenes, torneos, seminarios } = eventData;

// Update exam status based on date
const updatedExamenes = examenes.map(examen => {
  // If the exam date is in the past and status is "Programado", change to "Finalizado"
  if (isPastDate(examen.fecha) && examen.estado === 'Programado') {
    return { ...examen, estado: 'Finalizado' };
  }
  return examen;
});

console.log('Raw torneos data:', torneos);

// Update tournament status based on date
const updatedTorneos = torneos.map(torneo => {
  console.log(`Tournament check: ${torneo.nombre} - fecha: ${torneo.fecha}, estado: ${torneo.estado}, isPast: ${isPastDate(torneo.fecha)}`);
  // If the tournament date is in the past and status is "Inscripciones Abiertas", change to "Finalizado"
  if (isPastDate(torneo.fecha) && torneo.estado === 'Inscripciones Abiertas') {
    console.log(`Changing tournament "${torneo.nombre}" from "${torneo.estado}" to "Finalizado"`);
    return { ...torneo, estado: 'Finalizado' };
  }
  // Also check for "Inscripciones abiertas" (lowercase 'a')
  if (isPastDate(torneo.fecha) && torneo.estado === 'Inscripciones abiertas') {
    console.log(`Changing tournament "${torneo.nombre}" from "${torneo.estado}" to "Finalizado"`);
    return { ...torneo, estado: 'Finalizado' };
  }
  return torneo;
});

console.log('Updated torneos data:', updatedTorneos);

// Update seminario status based on date (similar to exams and tournaments)
const updatedSeminarios = seminarios.map(seminario => {
  console.log(`Seminario check: ${seminario.titulo} - fecha: ${seminario.fecha}, isPast: ${isPastDate(seminario.fecha)}`);
  // If the seminario date is in the past, we'll handle the registration button separately
  // but we can track if it's past for UI purposes
  return { ...seminario, isPast: isPastDate(seminario.fecha) };
});

console.log('Updated seminarios data:', updatedSeminarios);

// Filter upcoming events (use updated examenes, torneos, and seminarios)
const upcomingExamenes = updatedExamenes.filter(exam => isUpcoming(exam.fecha));
const upcomingTorneos = updatedTorneos.filter(torneo => isUpcoming(torneo.fecha));
const upcomingSeminarios = updatedSeminarios.filter(seminario => isUpcoming(seminario.fecha));

// Debug filtered results
console.log('Filtered upcoming events:', {
  examenes: upcomingExamenes.length,
  torneos: upcomingTorneos.length,
  seminarios: upcomingSeminarios.length
});

// If no upcoming events, show all events for debugging
const displayExamenes = upcomingExamenes.length > 0 ? upcomingExamenes : updatedExamenes;
const displayTorneos = upcomingTorneos.length > 0 ? upcomingTorneos : updatedTorneos;
const displaySeminarios = upcomingSeminarios.length > 0 ? upcomingSeminarios : updatedSeminarios;

console.log('Events to display:', {
  examenes: displayExamenes.length,
  torneos: displayTorneos.length,
  seminarios: displaySeminarios.length
});
---

<Layout title="Eventos - Escuela Ul-ji Taekwondo">
  <main class="min-h-screen bg-white dark:bg-gray-900">
    
    <!-- Hero Section -->
    <section class="bg-gradient-primary dark:from-brand-purple dark:to-ulji-red-800 py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-6xl font-heading font-bold text-white mb-6">
          Eventos
        </h1>
        <p class="text-xl font-text text-white/90 max-w-2xl mx-auto">
          Participa en exámenes, torneos y encuentros especiales de nuestra comunidad
        </p>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
          <div class="text-center">
            <div class="text-3xl font-heading font-bold text-white">{displayExamenes.length}</div>
            <div class="text-white/80 font-text">Próximos Exámenes</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-heading font-bold text-white">{displayTorneos.length}</div>
            <div class="text-white/80 font-text">Torneos Activos</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-heading font-bold text-white">{displaySeminarios.length}</div>
            <div class="text-white/80 font-text">Seminarios Programados</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Navigation Tabs -->
    <section class="bg-white dark:bg-gray-800 shadow-lg sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex space-x-8 overflow-x-auto py-4">
          <button data-tab="examenes" class="tab-button whitespace-nowrap text-brand-red dark:text-ulji-red-400 border-b-2 border-brand-red dark:border-ulji-red-400 px-4 py-2 font-heading font-semibold">
            Exámenes ({displayExamenes.length})
          </button>
          <button data-tab="torneos" class="tab-button whitespace-nowrap text-gray-600 dark:text-gray-400 hover:text-brand-red dark:hover:text-ulji-red-400 px-4 py-2 font-heading font-semibold transition-colors duration-300">
            Torneos ({displayTorneos.length})
          </button>
          <button data-tab="seminarios" class="tab-button whitespace-nowrap text-gray-600 dark:text-gray-400 hover:text-brand-red dark:hover:text-ulji-red-400 px-4 py-2 font-heading font-semibold transition-colors duration-300">
            Seminarios ({displaySeminarios.length})
          </button>
        </nav>
      </div>
    </section>

    <!-- Exámenes Section -->
    <section id="examenes" class="tab-content py-16 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 dark:text-white mb-6">
            Próximos Exámenes de Grado
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg font-text text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Evalúa tu progreso y avanza al siguiente nivel en tu entrenamiento de Taekwondo
          </p>
        </div>

        {displayExamenes.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {displayExamenes.map((examen) => (
              <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-xl font-heading font-bold text-gray-900 dark:text-white">{examen.tipo}</h3>
                  <span class="text-sm bg-ulji-green-100 dark:bg-ulji-green-900/30 text-ulji-green-700 dark:text-ulji-green-300 px-3 py-1 rounded-full font-medium">
                    {formatDate(examen.fecha)}
                  </span>
                </div>
                
                <div class="space-y-3 text-gray-600 dark:text-gray-400">
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-brand-red mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="font-text font-medium">{examen.grado}</span>
                  </div>
                  
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-text">{examen.lugar}</span>
                  </div>
                  
                  <div class="flex items-center">
                    <svg class="w-4 h-4 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-text">{examen.hora}</span>
                  </div>
                </div>
                
                {examen.requisitos && (
                  <div class="mt-4 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                    <p class="text-sm font-text text-gray-700 dark:text-gray-300">
                      <strong>Requisitos:</strong> {examen.requisitos}
                    </p>
                  </div>
                )}

                {examen.estado && (
                  <div class="mt-4">
                    <span class={`inline-block px-3 py-1 rounded-full text-sm font-semibold ${
                      examen.estado === 'Abierto' ? 'bg-green-100 text-green-800' :
                      examen.estado === 'Próximamente' ? 'bg-yellow-100 text-yellow-800' :
                      examen.estado === 'Finalizado' ? 'bg-gray-100 text-gray-800' :
                      'bg-blue-100 text-blue-800'
                    }`}>
                      {examen.estado}
                    </span>
                  </div>
                )}
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <h3 class="text-lg font-heading font-semibold text-gray-900 dark:text-white mb-2">No hay exámenes programados</h3>
            <p class="font-text text-gray-600 dark:text-gray-400">Los próximos exámenes se anunciarán pronto.</p>
          </div>
        )}
      </div>
    </section>

    <!-- Torneos Section -->
    <section id="torneos" class="tab-content hidden py-16 bg-gray-50 dark:bg-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 dark:text-white mb-6">
            Torneos y Competencias
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg font-text text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Compite y demuestra tus habilidades en torneos locales, nacionales e internacionales
          </p>
        </div>

        {displayTorneos.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {displayTorneos.map((torneo) => (
              <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-start justify-between mb-6">
                  <div>
                    <h3 class="text-2xl font-heading font-bold text-gray-900 dark:text-white mb-2">{torneo.nombre}</h3>
                    <p class="text-brand-red dark:text-ulji-red-400 font-heading font-semibold">{torneo.categoria}</p>
                  </div>
                  <span class="bg-brand-red text-white px-4 py-2 rounded-lg font-heading font-bold text-lg">
                    {formatDate(torneo.fecha)}
                  </span>
                </div>
                
                <div class="space-y-4 mb-6">
                  <div class="flex items-center text-gray-600 dark:text-gray-400">
                    <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-text">{torneo.lugar}</span>
                  </div>
                  
                  <div class="flex items-center text-gray-600 dark:text-gray-400">
                    <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="font-text">Inscripción: {torneo.inscripcion}</span>
                  </div>
                  
                  {torneo.costo && (
                    <div class="flex items-center text-gray-600 dark:text-gray-400">
                      <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                      </svg>
                      <span class="font-text">Costo: {torneo.costo}</span>
                    </div>
                  )}

                  {torneo.premio && (
                    <div class="flex items-center text-gray-600 dark:text-gray-400">
                      <svg class="w-5 h-5 text-brand-red mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 2L3 9h4v9h6v-9h4l-7-7z" clip-rule="evenodd"></path>
                      </svg>
                      <span class="font-text">Premio: {torneo.premio}</span>
                    </div>
                  )}
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                  <div class="text-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                    <div class="text-sm font-text text-gray-500 dark:text-gray-400">Nivel</div>
                    <div class="font-heading font-semibold text-gray-900 dark:text-white">{torneo.nivel}</div>
                  </div>
                  {torneo.modalidad && (
                    <div class="text-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                      <div class="text-sm font-text text-gray-500 dark:text-gray-400">Modalidad</div>
                      <div class="font-heading font-semibold text-gray-900 dark:text-white">{torneo.modalidad}</div>
                    </div>
                  )}
                </div>

                {torneo.estado && (
                  <div class="flex justify-between items-center">
                    <span class={`inline-block px-4 py-2 rounded-full text-sm font-heading font-semibold ${
                      torneo.estado === 'Inscripciones Abiertas' ? 'bg-green-100 text-green-800' :
                      torneo.estado === 'Próximamente' ? 'bg-yellow-100 text-yellow-800' :
                      torneo.estado === 'Finalizado' ? 'bg-gray-100 text-gray-800' :
                      'bg-gray-100 text-gray-800'
                    }`}>
                      {torneo.estado}
                    </span>
                    {/* Only show "Inscribirse" button if tournament is not finished */}
                    {torneo.estado !== 'Finalizado' && !isPastDate(torneo.fecha) && (
                      <button class="bg-brand-red hover:bg-brand-red-deep text-white px-6 py-2 rounded-lg font-heading font-semibold transition-colors duration-300">
                        Inscribirse
                      </button>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            <h3 class="text-lg font-heading font-semibold text-gray-900 dark:text-white mb-2">No hay torneos programados</h3>
            <p class="font-text text-gray-600 dark:text-gray-400">Los próximos torneos se anunciarán pronto.</p>
          </div>
        )}
      </div>
    </section>

    <!-- Seminarios Section -->
    <section id="seminarios" class="tab-content hidden py-16 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 dark:text-white mb-6">
            Seminarios y Encuentros
          </h2>
          <div class="w-24 h-1 bg-brand-red mx-auto mb-8"></div>
          <p class="text-lg font-text text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Eventos especiales con grandes maestros y actividades de la comunidad
          </p>
        </div>

        {displaySeminarios.length > 0 ? (
          <div class="space-y-6">
            {displaySeminarios.map((seminario) => (
              <div class="bg-gradient-to-r from-white to-gray-50 dark:from-gray-800 dark:to-gray-700 rounded-xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                  <div class="flex-1">
                    <div class="flex items-center mb-4">
                      <div class="w-12 h-12 bg-brand-red rounded-full flex items-center justify-center mr-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                      </div>
                      <div>
                        <h3 class="text-2xl font-heading font-bold text-gray-900 dark:text-white">{seminario.titulo}</h3>
                        <p class="text-brand-red dark:text-ulji-red-400 font-heading font-semibold">Con {seminario.maestro}</p>
                      </div>
                    </div>
                    
                    <p class="font-text text-gray-600 dark:text-gray-400 mb-4 text-lg">{seminario.tema}</p>
                    
                    {seminario.descripcion && (
                      <p class="font-text text-gray-500 dark:text-gray-500 mb-4">{seminario.descripcion}</p>
                    )}
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm font-text text-gray-500 dark:text-gray-400 mb-4">
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                        </svg>
                        {seminario.duracion}
                      </div>
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"></path>
                        </svg>
                        {seminario.costo}
                      </div>
                      {seminario.cupos && (
                        <div class="flex items-center">
                          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"></path>
                          </svg>
                          {seminario.cupos}
                        </div>
                      )}
                      {seminario.nivel && (
                        <div class="flex items-center">
                          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                          </svg>
                          {seminario.nivel}
                        </div>
                      )}
                    </div>

                    {seminario.lugar && (
                      <div class="flex items-center text-gray-600 dark:text-gray-400">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span class="font-text">{seminario.lugar}</span>
                      </div>
                    )}
                  </div>
                  
                  <div class="mt-6 lg:mt-0 lg:ml-8">
                    <div class="text-center">
                      <div class={`px-6 py-3 rounded-lg font-heading font-bold text-xl mb-4 ${
                        isPastDate(seminario.fecha) ? 'bg-gray-400 text-white' : 'bg-brand-red text-white'
                      }`}>
                        {formatDate(seminario.fecha)}
                      </div>
                      {!isPastDate(seminario.fecha) && (
                        <button class="bg-transparent border-2 border-brand-red text-brand-red hover:bg-brand-red hover:text-white px-6 py-2 rounded-lg font-heading font-semibold transition-colors duration-300">
                          Inscribirse
                        </button>
                      )}
                      {isPastDate(seminario.fecha) && (
                        <div class="text-gray-500 font-heading font-semibold px-6 py-2">
                          Evento Finalizado
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <h3 class="text-lg font-heading font-semibold text-gray-900 dark:text-white mb-2">No hay seminarios programados</h3>
            <p class="font-text text-gray-600 dark:text-gray-400">Los próximos seminarios se anunciarán pronto.</p>
          </div>
        )}
      </div>
    </section>

  </main>
</Layout>

<script>
  // Tab functionality
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    function switchTab(targetTab: string): void {
      // Update buttons
      tabButtons.forEach(button => {
        const buttonElement = button as HTMLElement;
        const tabValue = buttonElement.getAttribute('data-tab');
        const isActive = tabValue === targetTab;
        
        if (isActive) {
          buttonElement.classList.remove('text-gray-600', 'dark:text-gray-400');
          buttonElement.classList.add('text-brand-red', 'dark:text-ulji-red-400', 'border-b-2', 'border-brand-red', 'dark:border-ulji-red-400');
        } else {
          buttonElement.classList.remove('text-brand-red', 'dark:text-ulji-red-400', 'border-b-2', 'border-brand-red', 'dark:border-ulji-red-400');
          buttonElement.classList.add('text-gray-600', 'dark:text-gray-400');
        }
      });

      // Update content
      tabContents.forEach(content => {
        const isActive = content.id === targetTab;
        content.classList.toggle('hidden', !isActive);
      });
    }

    // Add click event listeners to tab buttons
    tabButtons.forEach(button => {
      button.addEventListener('click', (e: Event) => {
        const target = e.currentTarget;
        if (target instanceof HTMLElement) {
          const tabValue = target.getAttribute('data-tab');
          if (tabValue) {
            switchTab(tabValue);
          }
        }
      });
    });

    // Set initial tab (examenes by default)
    switchTab('examenes');
  });
</script>
