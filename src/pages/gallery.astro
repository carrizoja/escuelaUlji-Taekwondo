---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import BeltStripe from '../components/BeltStripe.astro';
import GalleryWrapper from '../components/gallery/GalleryWrapper.vue';
import { WATERMARKS } from '../utils/watermark.js';
---

<Layout 
	title="Galería de Fotos | Escuela Ul-ji Taekwondo"
	description="Explora nuestra galería de fotos de entrenamientos, competiciones, exámenes y eventos especiales de la Escuela Ul-ji. Momentos memorables de nuestros estudiantes."
	keywords="galería taekwondo, fotos entrenamientos, fotos competiciones, exámenes cinturones, eventos escuela, técnicas taekwondo, competiciones, logros estudiantes"
>
  <main class="min-h-screen">

    <!-- Hero (dark tone) -->
    <Section tone="dark" class="py-20" watermark={WATERMARKS.events} watermarkPosition="top-left">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span aria-hidden="true" class="mb-4 block h-1 w-10 bg-brand-red"></span>
        <h1 class="heading text-4xl md:text-6xl mb-6">
          Galería
        </h1>
        <p class="text-xl text-muted max-w-2xl">
          Descubrí momentos inigualables, técnicas perfectas y el espíritu del Taekwon-Do en Ul-Ji
        </p>
      </div>
    </Section>
    <BeltStripe />

    <!-- Fotos Section -->
    <div id="fotos-section">
      <!-- Gallery with integrated filtering -->
      <GalleryWrapper client:load />
    </div>

  </main>
</Layout>
