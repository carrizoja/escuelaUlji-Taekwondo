                </div>

                <div class="flex gap-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300 cursor-pointer">
                  <div class="w-20 h-12 bg-gray-300 dark:bg-gray-600 rounded flex-shrink-0 flex items-center justify-center">
                    <svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">
                      Combate Deportivo - Estrategias
                    </p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                      18:22 • Hace 3 días
                    </p>
                  </div>
                </div>

                <div class="flex gap-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300 cursor-pointer">
                  <div class="w-20 h-12 bg-gray-300 dark:bg-gray-600 rounded flex-shrink-0 flex items-center justify-center">
                    <svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">
                      Filosofía del Taekwondo
                    </p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                      15:10 • Hace 5 días
                    </p>
                  </div>
                </div>

                <div class="flex gap-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300 cursor-pointer">
                  <div class="w-20 h-12 bg-gray-300 dark:bg-gray-600 rounded flex-shrink-0 flex items-center justify-center">
                    <svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">
                      Examen de Cinta Amarilla
                    </p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                      22:33 • Hace 1 semana
                    </p>
                  </div>
                </div>

                <div class="flex gap-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-300 cursor-pointer">
                  <div class="w-20 h-12 bg-gray-300 dark:bg-gray-600 rounded flex-shrink-0 flex items-center justify-center">
                    <svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">
                      Calentamiento y Estiramientos
                    </p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                      8:45 • Hace 2 días
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

  </main>
</Layout>

<script>
  // Tab functionality
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    function switchTab(targetTab: string): void {
      // Update buttons
      tabButtons.forEach(button => {
        const buttonElement = button as HTMLElement;
        const tabValue = buttonElement.getAttribute('data-tab');
        const isActive = tabValue === targetTab;
        
        buttonElement.classList.toggle('border-red-500', isActive);
        buttonElement.classList.toggle('text-red-600', isActive);
        buttonElement.classList.toggle('dark:text-red-400', isActive);
        buttonElement.classList.toggle('border-transparent', !isActive);
        buttonElement.classList.toggle('text-gray-500', !isActive);
        buttonElement.classList.toggle('dark:text-gray-400', !isActive);
      });

      // Update content
      tabContents.forEach(content => {
        const isActive = content.id === `${targetTab}-section`;
        content.classList.toggle('hidden', !isActive);
      });
    }

    tabButtons.forEach(button => {
      button.addEventListener('click', (e: Event) => {
        const target = e.currentTarget;
        if (target instanceof HTMLElement) {
          const tabValue = target.getAttribute('data-tab');
          if (tabValue) {
            switchTab(tabValue);
          }
        }
      });
    });

    // Smooth scroll for hash links
    const handleHashChange = (): void => {
      const hash = window.location.hash.slice(1);
      if (hash === 'fotos' || hash === 'videos') {
        switchTab(hash);
      }
    };

    window.addEventListener('hashchange', handleHashChange);
    handleHashChange(); // Check on load
  });
</script>
