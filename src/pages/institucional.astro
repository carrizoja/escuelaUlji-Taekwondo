---
// Institucional page - About Us section
import Layout from '../layouts/Layout.astro';
import Instructors from '../components/Instructors.astro';
import About from '../components/blocks/About.astro';
import GradientLine from '../components/ui/GradientLine.astro';
import Section from '../components/Section.astro';
import BeltStripe from '../components/BeltStripe.astro';
import ThirdButton from '../components/ui/ThirdButton.astro';
---

<Layout 
	title="Institucional - Nuestra Escuela | Escuela Ul-ji Taekwondo"
	description="Conoce la historia, misión y valores de la Escuela Ul-ji. Nuestros instructores, metodología de enseñanza y compromiso con la formación integral en Taekwondo."
	keywords="escuela taekwondo Buenos Aires, instructores certificados, misión escuela Ul-ji, valores marciales, metodología enseñanza, formación integral, historia escuela"
>
  <main class="min-h-screen">

    <!-- Hero (dark tone) -->
    <Section tone="dark" class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span aria-hidden="true" class="mb-4 block h-1 w-10 bg-brand-red"></span>
        <h1 class="heading text-4xl md:text-6xl mb-6">
          Institucional
        </h1>
        <p class="text-xl text-muted max-w-2xl">
          Conocé más sobre nuestra escuela, nuestra misión y nuestra visión
        </p>
      </div>
    </Section>
    <BeltStripe />

    <!-- Navigation Tabs -->
    <div class="tone-light sticky top-20 z-40 border-b border-line shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex space-x-8 overflow-x-auto py-4">
          <a href="#nosotros" class="whitespace-nowrap text-eyebrow border-b-2 border-eyebrow px-4 py-2 font-semibold">
            Nosotros
          </a>
          <a href="#instructores" class="whitespace-nowrap text-muted hover:text-eyebrow px-4 py-2 font-semibold transition-colors duration-300">
            Instructores
          </a>
          <a href="#mision" class="whitespace-nowrap text-muted hover:text-eyebrow px-4 py-2 font-semibold transition-colors duration-300">
            Misión
          </a>
          <a href="#vision" class="whitespace-nowrap text-muted hover:text-eyebrow px-4 py-2 font-semibold transition-colors duration-300">
            Visión
          </a>
        </nav>
      </div>
    </div>
    <!-- About Section -->
    <About />

    <!-- Instructores Component -->
    <Instructors />

    <!-- Misión Section -->
    <Section tone="light" id="mision" class="py-16 !bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="heading text-3xl md:text-4xl mb-6">
            Nuestra Misión
          </h2>
          <GradientLine />
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="order-2 lg:order-1">
            <img 
              src="https://res.cloudinary.com/dgvje1bpw/image/upload/v1757687611/20221127_103145_kjnrei.jpg" 
              alt="Misión Escuela Ul-ji"
              class="w-full h-96 object-cover rounded-xl shadow-lg"
            />
          </div>
          <div class="order-1 lg:order-2">
            <div class="bg-card border border-line p-8 rounded-xl shadow-lg">
              <h3 class="heading text-2xl text-eyebrow mb-6">
                Formar personas con valores
              </h3>
              <p class="text-lg text-fg mb-6 leading-relaxed">
                A través de la práctica del Taekwon-do, transmitiendo sus valores (cortesía, autocontrol, espíritu indomable, integridad y perseverancia).
              </p>
               <p class="text-lg text-fg mb-6 leading-relaxed">
                Brindar un espacio inclusivo y seguro donde niños, niñas, jóvenes y adultos desarrollen sus habilidades físicas, mentales y emocionales, fortaleciendo el cuerpo y el carácter.
              </p>
              <p class="text-lg text-fg mb-6 leading-relaxed">
                Creemos que el verdadero arte marcial trasciende las técnicas de combate y se convierte en una filosofía de vida que promueve la paz, el respeto y el crecimiento personal continuo.
              </p>
              <div class="bg-surface border border-line p-4 rounded-lg border-l-4 !border-l-brand-red">
                <p class="text-fg font-medium italic">
                  "No formamos solo luchadores, formamos personas íntegras que utilizan el Taekwondo como herramienta de transformación personal y social."
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Visión Section -->
    <Section tone="light" id="vision" class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="heading text-3xl md:text-4xl mb-6">
            Nuestra Visión
          </h2>
          <GradientLine />
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="bg-surface border border-line p-8 rounded-xl">
              <h3 class="heading text-2xl text-eyebrow mb-6">
                Líderes en Excelencia Marcial
              </h3>
              <p class="text-lg text-fg mb-6 leading-relaxed">
                Ser una escuela referente de Taekwondo en la comunidad argentina; sobre todo, en Buenos Aires, reconocida por su excelencia técnica, calidad humana, inclusión social y su compromiso con la educación en valores y su capacidad de inspirar a las personas a alcanzar sus sueños y máximo potencial dentro y fuera del dojang.
              </p>
              <p class="text-lg text-fg mb-6 leading-relaxed">
                Visualizamos un futuro donde cada graduado de Ul-ji sea un embajador de los valores del Taekwondo, contribuyendo a crear una sociedad más disciplinada, respetuosa y pacífica.
              </p>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
                <div class="text-center p-4 bg-card border border-line rounded-lg shadow">
                  <div class="text-3xl font-bold text-eyebrow mb-2">2030</div>
                  <div class="text-sm text-muted">Meta: 500+ estudiantes formados</div>
                </div>
                <div class="text-center p-4 bg-card border border-line rounded-lg shadow">
                  <div class="text-3xl font-bold text-eyebrow mb-2">5+</div>
                  <div class="text-sm text-muted">Cinturones negro certificados</div>
                </div>
              </div>
            </div>
          </div>
          <div class="relative overflow-hidden rounded-xl group">
            <img 
              src="https://res.cloudinary.com/dgvje1bpw/image/upload/v1756927931/santana_ntbmka.jpg" 
              alt="Visión Escuela Ul-ji"
              class="w-full h-96 object-cover rounded-xl shadow-lg transition-transform duration-500 group-hover:scale-110 group-hover:brightness-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl"></div>
            <div class="absolute bottom-4 left-4 text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <p class="text-lg font-semibold">Sabum Nim Horacio Santana</p>
              <p class="text-sm text-gray-200">Fundador Escuela Ul-ji</p>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Call to Action (dark tone) -->
    <Section tone="dark" class="py-16">
      <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <h2 class="heading text-3xl mb-4">¿Listo para comenzar tu viaje en Taekwon-do?</h2>
        <p class="text-lg text-muted mb-8">Unite a la familia Ul-Ji y descubrí todo tu potencial</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <ThirdButton
            href="/#sedes"
            variant="primary"
          >
            Información de Clases
          </ThirdButton>
          <ThirdButton
            href="/gallery"
            variant="outline"
          >
            Ver Galería
          </ThirdButton>
        </div>
      </div>
    </Section>

  </main>
</Layout>

<script>
  // Smooth scrolling for navigation links
  document.addEventListener('DOMContentLoaded', function() {
    const navLinks = document.querySelectorAll('nav a[href^="#"]');
    
    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const clickedLink = e.currentTarget;
        
        if (clickedLink && clickedLink instanceof HTMLAnchorElement) {
          const targetId = clickedLink.getAttribute('href')?.substring(1);
          const targetElement = targetId ? document.getElementById(targetId) : null;
          
          if (targetElement && targetElement instanceof HTMLElement) {
            const offsetTop = targetElement.offsetTop - 100; // Account for sticky nav
            
            window.scrollTo({
              top: offsetTop,
              behavior: 'smooth'
            });
            
            // Update active nav item
            navLinks.forEach(navLink => {
              if (navLink instanceof HTMLElement) {
                navLink.classList.remove('text-eyebrow', 'border-b-2', 'border-eyebrow');
                navLink.classList.add('text-muted');
              }
            });
            
            clickedLink.classList.add('text-eyebrow', 'border-b-2', 'border-eyebrow');
            clickedLink.classList.remove('text-muted');
          }
        }
      });
    });

    // Update active nav item on scroll
    const sections = document.querySelectorAll('section[id]');
    
    function updateActiveNav() {
      const scrollY = window.pageYOffset;
      
      sections.forEach(section => {
        if (section instanceof HTMLElement) {
          const sectionTop = section.offsetTop - 150;
          const sectionBottom = sectionTop + section.offsetHeight;
          const sectionId = section.getAttribute('id');
          
          if (scrollY >= sectionTop && scrollY < sectionBottom && sectionId) {
            navLinks.forEach(navLink => {
              if (navLink instanceof HTMLElement) {
                navLink.classList.remove('text-eyebrow', 'border-b-2', 'border-eyebrow');
                navLink.classList.add('text-muted');
                
                if (navLink.getAttribute('href') === `#${sectionId}`) {
                  navLink.classList.add('text-eyebrow', 'border-b-2', 'border-eyebrow');
                  navLink.classList.remove('text-muted');
                }
              }
            });
          }
        }
      });
    }

    window.addEventListener('scroll', updateActiveNav);
    updateActiveNav(); // Initial call
  });
</script>
