---
// Footer component for Escuela Ul-ji Taekwondo
---

<footer class="bg-gray-900 dark:bg-black text-white transition-colors duration-300 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5 dark:opacity-10">
    <div class="absolute top-10 left-10 w-32 h-32 border-2 border-red-500 dark:border-red-400 rotate-45"></div>
    <div class="absolute bottom-10 right-10 w-24 h-24 border-2 border-red-500 dark:border-red-400 rotate-12"></div>
    <div class="absolute top-1/2 left-1/3 w-16 h-16 border border-white dark:border-gray-300 rotate-45"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      
      <!-- School Info Section -->
      <div class="col-span-1 lg:col-span-2">
        <div class="flex items-center mb-4">
          <img 
            src="https://res.cloudinary.com/dgvje1bpw/image/upload/v1756572320/logo_ulji_gkw0wn.png" 
            alt="Logo Escuela Ul-ji"
            class="w-12 h-12 rounded-full mr-4 transition-transform duration-300 hover:scale-105"
          />
          <div>
            <h3 class="text-2xl font-bold text-white transition-colors duration-300">Escuela Ul-ji</h3>
            <p class="text-red-400 dark:text-red-300 font-semibold transition-colors duration-300">Siempre en crecimiento</p>
          </div>
        </div>
        <div class="flex space-x-4">
          <a href="#" class="bg-red-600 hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 text-white px-6 py-2 rounded-lg transition-colors duration-300 font-semibold">
            Clases de Prueba
          </a>
          <a href="#" class="border border-gray-600 hover:border-white dark:border-gray-500 dark:hover:border-gray-300 text-gray-300 hover:text-white dark:text-gray-200 dark:hover:text-white px-6 py-2 rounded-lg transition-colors duration-300">
            Más Información
          </a>
        </div>
      </div>

      <!-- Contact Section -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-red-400 dark:text-red-300 transition-colors duration-300">Contacto</h4>
        <div class="space-y-3">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-red-500 dark:text-red-400 mr-3 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-gray-300 dark:text-gray-200 transition-colors duration-300">Centro Cultural La Grieta, Alsina 2143 - CABA</span>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-red-500 dark:text-red-400 mr-3 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span class="text-gray-300 dark:text-gray-200 transition-colors duration-300">+54 11 6595-1634</span>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-red-500 dark:text-red-400 mr-3 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="text-gray-300 dark:text-gray-200 transition-colors duration-300">info@escuelaulji.com.ar</span>
          </div>
        </div>
      </div>

      <!-- Quick Links Section -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-red-400 dark:text-red-300 transition-colors duration-300">Enlaces Rápidos</h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-300 hover:text-white dark:text-gray-200 dark:hover:text-white transition-colors duration-300 hover:underline">Inicio</a></li>
          <li><a href="/gallery" class="text-gray-300 hover:text-white dark:text-gray-200 dark:hover:text-white transition-colors duration-300 hover:underline">Galería</a></li>
          <li><a href="#" class="text-gray-300 hover:text-white dark:text-gray-200 dark:hover:text-white transition-colors duration-300 hover:underline">Institucional</a></li>
          <li><a href="#" class="text-gray-300 hover:text-white dark:text-gray-200 dark:hover:text-white transition-colors duration-300 hover:underline">Eventos</a></li>
        </ul>
      </div>
    </div>

    <!-- Social Media & Bottom Section -->
    <div class="border-t border-gray-700 dark:border-gray-600 pt-8 transition-colors duration-300">
      <div class="flex flex-col md:flex-row justify-between items-center">
        
        <!-- Social Media Links -->
        <div class="flex space-x-6 mb-4 md:mb-0">
          <a href="https://www.facebook.com/horacio.santana.10" target="_blank" class="group relative text-gray-400 hover:text-red-400 dark:text-gray-300 dark:hover:text-red-300 transform hover:scale-110 transition-all duration-300 ease-in-out">
            <div class="absolute inset-0 bg-red-400/20 rounded-full scale-0 group-hover:scale-100 transition-transform duration-300 ease-out"></div>
            <svg class="w-6 h-6 relative z-10 filter group-hover:drop-shadow-lg transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/horacio_santana_tkd/" target="_blank" class="group relative text-gray-400 hover:text-red-400 dark:text-gray-300 dark:hover:text-red-300 transform hover:scale-110 transition-all duration-300 ease-in-out">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/20 via-pink-500/20 to-orange-500/20 rounded-full scale-0 group-hover:scale-100 transition-transform duration-300 ease-out"></div>
            <svg class="w-6 h-6 relative z-10 filter group-hover:drop-shadow-lg transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
        <!-- Copyright & Additional Info -->
        <div class="text-center md:text-right">
          <p class="text-gray-400 dark:text-gray-300 text-sm mb-1 transition-colors duration-300">
            © 2025 Escuela Ul-ji Taekwondo. Todos los derechos reservados.
          </p>
          <p class="text-gray-500 dark:text-gray-400 text-xs transition-colors duration-300">
            Afiliados a la Asociación Centro Internacional de Taekwondo (ACIT)
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Red accent line at bottom -->
  <div class="h-1 bg-gradient-to-r from-red-600 via-red-500 to-red-700 dark:from-red-500 dark:via-red-700 dark:to-red-500 transition-colors duration-300"></div>
</footer>