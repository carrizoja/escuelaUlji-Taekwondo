---
// Modern Contact component for Escuela Ul-ji Taekwondo
import QuickBenefits from './blocks/QuickBenefits.astro';
import { getActiveDojangs } from '../data/dojangs.js';
import GradientLine from './ui/GradientLine.astro';
import ContactButtons from './blocks/ContactButtons.astro';
import PrimaryButton from './ui/PrimaryButton.astro';
import FourthButton from './ui/FourthButton.astro';

const activeDojangs = getActiveDojangs();
---

<section
  class="py-10 bg-white dark:bg-gray-900 transition-colors duration-300"
>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Quick Benefits -->
        <QuickBenefits />
    <!-- Section Header -->
     <div id="sedes" class="mb-10 mt-10 text-center">
        <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 transition-colors duration-300"
      >
        Nuestras sedes
      </h2>
      <GradientLine />
      <p
        class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto transition-colors duration-300"
      >
        Descubrí nuestras ubicaciones y encontrá la más cercana a vos.
      </p>
      
      <!-- Dynamic Dojangs Blocks -->
      <div class="mt-8 space-y-6">
        {activeDojangs.map((dojang) => (
          <div class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 shadow-xl transition-colors duration-300">
            <div class="flex items-center mb-6">
              <div class="bg-red-500 rounded-full p-3 mr-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white transition-colors duration-300">
                  {dojang.name}
                </h3>
                <p class="text-gray-600 dark:text-gray-300 transition-colors duration-300">
                  {dojang.address.neighborhood}
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Address & Contact -->
              <div class="space-y-4">
                <div class="flex items-start">
                  <div>
                    <div class="flex items-center">
                      <svg class="w-5 h-5 text-red-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      </svg>
                      <h4 class="font-semibold text-gray-900 dark:text-white transition-colors duration-300">Dirección</h4>
                    </div>
                    <p class="text-gray-600 dark:text-gray-300 transition-colors duration-300 text-left">
                      {dojang.address.street}<br/>
                      {dojang.address.neighborhood}, {dojang.address.city}
                    </p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div>
                    <div class="flex items-center">
                      <svg class="w-5 h-5 text-red-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                      </svg>
                      <h4 class="font-semibold text-gray-900 dark:text-white transition-colors duration-300">Contacto</h4>
                    </div>
                    <p class="text-gray-600 text-left dark:text-gray-300 transition-colors duration-300">
                      {dojang.contact.phone}<br/>
                      {dojang.contact.email}
                    </p>
                  </div>
                </div>
              </div>

              <!-- Class Schedules -->
              <div class="space-y-4">
                <div class="flex items-start">
                  <div class="w-full">
                    <div class="flex items-center mb-3">
                      <svg class="w-5 h-5 text-red-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <h4 class="font-semibold text-gray-900 dark:text-white transition-colors duration-300">Horarios de Clases</h4>
                    </div>
                    <div class="space-y-3">
                      {dojang.schedules.classes.map((schedule) => (
                        <div class="bg-white dark:bg-gray-700 rounded-lg p-3 border-l-4 border-red-500 transition-colors duration-300">
                          <div class="flex justify-between items-center">
                            <div>
                              <p class="font-medium text-gray-900 dark:text-white transition-colors duration-300">
                                {schedule.category}
                              </p>
                              <p class="text-sm text-gray-600 dark:text-gray-300 transition-colors duration-300">
                                {schedule.ageRange}
                              </p>
                            </div>
                            <div class="text-right">
                              <p class="text-sm font-medium text-gray-900 dark:text-white transition-colors duration-300">
                                {schedule.days.join(" y ")}
                              </p>
                              <p class="text-sm text-gray-600 dark:text-gray-300 transition-colors duration-300">
                                {schedule.time}
                              </p>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
              <PrimaryButton 
                href={dojang.location.googleMapsUrl}
                text="Ver en Maps"
                icon="external"
                target="_blank"
                size="md"
              />
              <FourthButton
                href={`https://wa.me/${dojang.contact.whatsapp}?text=${encodeURIComponent('¡Hola! Me interesa información sobre las clases en la sede de ' + dojang.address.neighborhood)}`}
                variant="whatsapp"
                icon="whatsapp"
                size="md"
              >
                Consultar WhatsApp
              </FourthButton>
            </div>
          </div>
        ))}
      </div>
     </div>
    <div class="text-center mb-10 mt-10">
      <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 transition-colors duration-300"
      >
        Contactanos
      </h2>
      <GradientLine />
      <p
        class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto transition-colors duration-300"
      >
        ¿Listo para comenzar tu viaje en Taekwon-do? <br> Eligí tu canal preferido para comunicarte con nosotros
      </p>
         <!-- Quick Contact Buttons -->
    <ContactButtons />
    </div>

  </div>
</section>
