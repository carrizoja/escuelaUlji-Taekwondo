---
// FourthButton component - Specialized button for WhatsApp and social actions
export interface Props {
  href: string;
  variant?: 'whatsapp' | 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: 'whatsapp' | 'phone' | 'email' | 'external' | 'arrow';
  target?: '_blank' | '_self';
  rel?: string;
  class?: string;
}

const {
  href,
  variant = 'whatsapp',
  size = 'md',
  icon = 'whatsapp',
  target = '_blank',
  rel = 'noopener noreferrer',
  class: className = '',
} = Astro.props;

const baseClasses = 'group inline-flex items-center justify-center font-medium rounded-lg transition-all duration-300 gap-2 relative overflow-hidden';

const variantClasses = {
  whatsapp: 'bg-green-500 hover:bg-green-600 text-white shadow-lg hover:shadow-green-500/25',
  primary: 'bg-brand-red hover:bg-red-700 text-white shadow-lg hover:shadow-red-500/25',
  secondary: 'bg-gray-600 hover:bg-gray-700 text-white shadow-lg hover:shadow-gray-500/25',
  outline: 'border-2 border-white text-white hover:bg-white hover:text-ulji-red-500'
};

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

// Icon components
const icons = {
  whatsapp: `<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.787"/>`,
  phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>`,
  email: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>`,
  external: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>`,
  arrow: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>`
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<a
  href={href}
  target={target}
  rel={rel}
  class={buttonClasses}
>
  <!-- Progress bar overlay -->
  <div class="progress-bar absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"></div>
  
  <!-- Content -->
  <svg 
    class={`w-5 h-5 transition-transform duration-300 group-hover:scale-110 relative z-10 ${icon === 'whatsapp' ? 'fill-current' : ''}`} 
    fill={icon === 'whatsapp' ? 'currentColor' : 'none'} 
    stroke={icon === 'whatsapp' ? 'none' : 'currentColor'} 
    viewBox="0 0 24 24"
    set:html={icons[icon]}
  />
  <span class="relative z-10">
    <slot />
  </span>
</a>

<style>
  /* Progress bar hover effect */
  .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 20%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0.3) 80%,
      transparent 100%
    );
    width: 100%;
    height: 100%;
    transition: transform 0.7s ease-out;
    transform: translateX(-100%);
  }

  .group:hover .progress-bar {
    transform: translateX(100%);
  }


  /* WhatsApp variant specific progress effect */
  .group:hover.bg-green-500 .progress-bar,
  .group:hover[class*="bg-green"] .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.4) 20%,
      rgba(255, 255, 255, 0.6) 50%,
      rgba(255, 255, 255, 0.4) 80%,
      transparent 100%
    );
  }

  /* Primary variant specific progress effect */
  .group:hover.bg-brand-red .progress-bar,
  .group:hover[class*="bg-red"] .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.4) 20%,
      rgba(255, 255, 255, 0.6) 50%,
      rgba(255, 255, 255, 0.4) 80%,
      transparent 100%
    );
  }

  /* Outline variant specific progress effect */
  .group:hover[class*="border-"] .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(239, 68, 68, 0.2) 20%,
      rgba(239, 68, 68, 0.3) 50%,
      rgba(239, 68, 68, 0.2) 80%,
      transparent 100%
    );
  }

  /* Focus styles for accessibility */
  .group:focus-visible {
    outline: 2px solid #ef4444;
    outline-offset: 2px;
  }

  /* WhatsApp variant focus */
  .group.bg-green-500:focus-visible {
    outline-color: #10b981;
  }

  /* Primary variant focus */
  .group.bg-brand-red:focus-visible {
    outline-color: #ef4444;
  }

  /* Smooth transitions for all elements */
  .group {
    transition: all 0.3s ease-out;
  }

  /* Icon hover animations */
  .group:hover svg {
    filter: drop-shadow(0 2px 4px rgba(255, 255, 255, 0.2));
  }
</style>
