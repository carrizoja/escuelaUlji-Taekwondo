---
// ThirdButton component - Reusable button with download functionality
export interface Props {
  href: string;
  download?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: boolean;
  class?: string;
}

const {
  href,
  download,
  variant = 'primary',
  size = 'md',
  icon = false,
  class: className = '',
} = Astro.props;

const baseClasses = 'group inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-300 gap-2 relative overflow-hidden';

const variantClasses = {
  primary: 'bg-white text-brand-red hover:bg-gray-100',
  secondary: 'bg-brand-red text-white hover:bg-red-700',
  outline: 'border border-white text-white hover:bg-white hover:text-brand-red'
};

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-8 py-3 text-base',
  lg: 'px-10 py-4 text-lg'
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<a
  href={href}
  {download}
  class={buttonClasses}
>
  <!-- Progress bar overlay -->
  <div class="progress-bar absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"></div>
  
  <!-- Content -->
  {icon && (
    <svg class="w-4 h-4 transition-transform duration-300 group-hover:scale-110 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
    </svg>
  )}
  <span class="relative z-10">
    <slot />
  </span>
</a>

<style>
  /* Progress bar hover effect */
  .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 20%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0.3) 80%,
      transparent 100%
    );
    width: 100%;
    height: 100%;
    transition: transform 0.7s ease-out;
    transform: translateX(-100%);
  }

  .group:hover .progress-bar {
    transform: translateX(100%);
  }

  /* Primary variant specific progress effect */
  .group:hover.bg-white .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(239, 68, 68, 0.2) 20%,
      rgba(239, 68, 68, 0.3) 50%,
      rgba(239, 68, 68, 0.2) 80%,
      transparent 100%
    );
  }

  /* Secondary variant specific progress effect */
  .group:hover.bg-brand-red .progress-bar,
  .group:hover[class*="bg-red"] .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.4) 20%,
      rgba(255, 255, 255, 0.6) 50%,
      rgba(255, 255, 255, 0.4) 80%,
      transparent 100%
    );
  }

  /* Outline variant specific progress effect */
  .group:hover[class*="border-"] .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(239, 68, 68, 0.2) 20%,
      rgba(239, 68, 68, 0.3) 50%,
      rgba(239, 68, 68, 0.2) 80%,
      transparent 100%
    );
  }

  /* Focus styles for accessibility */
  .group:focus-visible {
    outline: 2px solid #ef4444;
    outline-offset: 2px;
  }

  /* Smooth transitions for all elements */
  .group {
    transition: all 0.3s ease-out;
  }

  /* Icon hover animations */
  .group:hover svg {
    filter: drop-shadow(0 2px 4px rgba(255, 255, 255, 0.2));
  }
</style>
