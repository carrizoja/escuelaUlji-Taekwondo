<div x-data="{            
    slides: [                
        {
            imgSrc: 'https://res.cloudinary.com/dgvje1bpw/image/upload/v1757621302/20220515_110812_deuafr.jpg',
            imgAlt: 'Sabum Nim Horacio practicando técnicas básicas en el dojang.',  
            title: 'Entrenamiento técnico',
            description: 'Aprendé las técnicas fundamentales que forman parte del Taekwon-do ITF.',              
        },                
        {                    
            imgSrc: 'https://res.cloudinary.com/dgvje1bpw/image/upload/v1757619590/torneo2_gmovck.jpg',                    
            imgAlt: 'Atleta de Taekwon-do compitiendo en campeonato regional.',  
            title: 'Competencias y Torneos',
            description: 'Participá en competencias locales y nacionales. Poné a prueba tus habilidades contra otros competidores.',              
        },                
        {                    
            imgSrc: 'https://res.cloudinary.com/dgvje1bpw/image/upload/v1757620748/examen_ubcfb7.jpg',                    
            imgAlt: 'Muestra de formas en examen en la escuela de Ulji Taekwon-do.',    
            title: 'Exámenes de Grado',
            description: 'Avanzá en tu camino marcial. Desde cinturón blanco hasta cinturón negro, cada grado representa tu dedicación y progreso.'             
        },
        {                    
            imgSrc: 'https://res.cloudinary.com/dgvje1bpw/image/upload/v1757621597/download_1_soon7b.jpg',                    
            imgAlt: 'Clases abiertas de Taekwon-do en un parque de Palermo.',    
            title: 'Eventos y Exhibiciones',
            description: 'Formá parte de eventos especiales y demostraciones de Taekwon-do en familia.'             
        },            
    ],            
    currentSlideIndex: 1,
    autoSlideInterval: null,
    slideDirection: 'next',
    
    init() {
        // Auto-slide disabled
    },
    
    startAutoSlide() {
        this.autoSlideInterval = setInterval(() => {
            this.next();
        }, 7000); // Slower auto-slide for better UX
    },
    
    stopAutoSlide() {
        if (this.autoSlideInterval) {
            clearInterval(this.autoSlideInterval);
            this.autoSlideInterval = null;
        }
    },
    
    restartAutoSlide() {
        this.stopAutoSlide();
        setTimeout(() => this.startAutoSlide(), 3000); // Wait before restarting
    },
    
    previous() {
        this.slideDirection = 'prev';                
        if (this.currentSlideIndex > 1) {                    
            this.currentSlideIndex = this.currentSlideIndex - 1                
        } else {   
            // If it's the first slide, go to the last slide           
            this.currentSlideIndex = this.slides.length                
        }
        // Auto-slide disabled - no restart needed           
    },            
    next() {
        this.slideDirection = 'next';                
        if (this.currentSlideIndex < this.slides.length) {                    
            this.currentSlideIndex = this.currentSlideIndex + 1                
        } else {                 
            // If it's the last slide, go to the first slide    
            this.currentSlideIndex = 1                
        }
        // Auto-slide disabled - no restart needed            
    },
    
    goToSlide(index) {
        this.slideDirection = index + 1 > this.currentSlideIndex ? 'next' : 'prev';
        this.currentSlideIndex = index + 1;
        // Auto-slide disabled - no restart needed
    },
    
    destroy() {
        this.stopAutoSlide();
    }        
}" class="relative w-full overflow-hidden" 
   x-init="init()">

    <!-- previous button -->
    <button type="button" class="absolute left-5 top-1/2 z-20 flex rounded-full -translate-y-1/2 items-center justify-center bg-white/40 p-2 text-neutral-600 transition hover:bg-white/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black active:outline-offset-0 dark:bg-neutral-950/40 dark:text-neutral-300 dark:hover:bg-neutral-950/60 dark:focus-visible:outline-white" aria-label="previous slide" x-on:click="previous()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="3" class="size-5 md:size-6 pr-0.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
    </button> 

    <!-- next button -->
   <button type="button" class="absolute right-5 top-1/2 z-20 flex rounded-full -translate-y-1/2 items-center justify-center bg-white/40 p-2 text-neutral-600 transition hover:bg-white/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black active:outline-offset-0 dark:bg-neutral-950/40 dark:text-neutral-300 dark:hover:bg-neutral-950/60 dark:focus-visible:outline-white" aria-label="next slide" x-on:click="next()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="3" class="size-5 md:size-6 pl-0.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
    </button>
   
    <!-- slides -->
    <div class="relative min-h-[50svh] w-fulloverflow-hidden">
        <template x-for="(slide, index) in slides">
            <div x-cloak x-show="currentSlideIndex == index + 1" class="absolute inset-0">
                
                <!-- Image -->
                <img class="absolute w-full h-full inset-0 object-cover text-neutral-600 dark:text-neutral-300" 
                     x-bind:src="slide.imgSrc" 
                     x-bind:alt="slide.imgAlt" />
                
                <!-- Enhanced gradient overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-5"></div>
                
                <!-- Additional dark overlay for better text contrast -->
                <div class="absolute inset-0 bg-black/30 z-5"></div>
                
                <!-- Title and description with stagger animation -->
                <div class="lg:px-32 lg:py-14 absolute inset-0 z-10 flex flex-col items-center justify-end gap-2 px-16 py-12 text-center">
                    <h3 class="w-full lg:w-[80%] text-balance text-2xl lg:text-3xl font-bold text-white transform transition-all duration-700 delay-200" 
                        x-text="slide.title" 
                        x-bind:aria-describedby="'slide' + (index + 1) + 'Description'"
                        x-bind:class="currentSlideIndex == index + 1 ? 'translate-y-0 opacity-100' : 'translate-y-4 opacity-0'"></h3>
                    <p class="lg:w-1/2 w-full text-pretty text-sm text-neutral-300 transform transition-all duration-700 delay-400" 
                       x-text="slide.description" 
                       x-bind:id="'slide' + (index + 1) + 'Description'"
                       x-bind:class="currentSlideIndex == index + 1 ? 'translate-y-0 opacity-100' : 'translate-y-4 opacity-0'"></p>
                </div>
            </div>
        </template>
    </div>
    
    <!-- Enhanced indicators with animation -->
    <div class="absolute rounded-full bottom-3 md:bottom-5 left-1/2 z-20 flex -translate-x-1/2 gap-4 md:gap-3 px-3 py-2 bg-black/20 backdrop-blur-sm" role="group" aria-label="slides" >
        <template x-for="(slide, index) in slides">
            <button class="size-2 rounded-full transition-all duration-300 hover:scale-125" 
                    x-on:click="goToSlide(index)" 
                    x-bind:class="[currentSlideIndex === index + 1 ? 'bg-white scale-110' : 'bg-white/50 hover:bg-white/70']" 
                    x-bind:aria-label="'slide ' + (index + 1)"></button>
        </template>
    </div>
</div>