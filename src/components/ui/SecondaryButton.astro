---
// Secondary Button component for Escuela Ul-ji Taekwondo
interface Props {
  href?: string;
  text: string;
  icon?: 'arrow' | 'gallery' | 'phone' | 'email' | 'calendar' | 'user' | 'star' | 'heart' | 'download' | 'external';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  target?: '_blank' | '_self';
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { 
  href,
  text,
  icon = 'gallery',
  size = 'md',
  disabled = false,
  target = '_self',
  class: className = '',
  id,
  type = 'button'
} = Astro.props;

// Size classes
const sizeClasses = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2 text-base',
  lg: 'px-5 py-2.5 text-base'
};

// Icon components
const icons = {
  arrow: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>`,
  gallery: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>`,
  phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>`,
  email: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>`,
  calendar: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>`,
  user: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>`,
  star: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>`,
  heart: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>`,
  download: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>`,
  external: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>`
};

const baseClasses = `group font-bold rounded-lg transition-all duration-300 inline-flex items-center justify-center gap-3 relative overflow-hidden border-2 border-white hover:border-ulji-red-400 dark:border-gray-300 dark:hover:border-ulji-red-300 text-white hover:text-ulji-red-400 dark:hover:text-ulji-red-300 hover:bg-white/10 dark:hover:bg-gray-800/30 ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`;
const buttonClasses = `${baseClasses} ${sizeClasses[size]} ${className}`;

const Element = href ? 'a' : 'button';
---

<Element
  href={href}
  target={target}
  class={buttonClasses}
  disabled={disabled}
  type={href ? undefined : type}
  id={id}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
>
  <!-- Progress bar overlay for secondary button -->
  <div class="progress-bar absolute inset-0 bg-gradient-to-r from-transparent via-ulji-red-400/20 to-transparent transform -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out"></div>
  
  <!-- Content -->
  <span class="relative z-10">{text}</span>
  <svg 
    class={`w-6 h-6 transition-transform duration-300 relative z-10 ${
      icon === 'arrow' ? 'group-hover:translate-x-1' : 
      icon === 'gallery' ? 'group-hover:scale-110' :
      icon === 'external' ? 'group-hover:scale-110' :
      'group-hover:scale-105'
    }`} 
    fill="none" 
    stroke="currentColor" 
    viewBox="0 0 24 24"
    set:html={icons[icon]}
  />
</Element>

<style>
  /* Progress bar hover effect for secondary button */
  .progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(239, 68, 68, 0.15) 20%,
      rgba(239, 68, 68, 0.25) 50%,
      rgba(239, 68, 68, 0.15) 80%,
      transparent 100%
    );
    width: 100%;
    height: 100%;
    transition: transform 0.7s ease-out;
    transform: translateX(-100%);
  }

  .group:hover .progress-bar {
    transform: translateX(100%);
  }

  /* Enhanced button hover effects */
  .group:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(239, 68, 68, 0.15);
  }

  /* Focus styles for accessibility */
  .group:focus-visible {
    outline: 2px solid #ef4444;
    outline-offset: 2px;
  }

  /* Disabled state */
  .group:disabled {
    transform: none !important;
    animation: none !important;
  }

  .group:disabled:hover {
    transform: none !important;
    box-shadow: none !important;
  }

  .group:disabled .progress-bar {
    display: none;
  }

  /* Smooth transitions for all elements */
  .group {
    transition: all 0.3s ease-out;
  }

  /* Icon hover animations */
  .group:hover svg {
    filter: drop-shadow(0 2px 4px rgba(239, 68, 68, 0.2));
  }

  /* Border animation enhancement */
  .group {
    position: relative;
  }

  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(45deg, transparent, rgba(239, 68, 68, 0.1), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .group:hover::before {
    opacity: 1;
  }
</style>
