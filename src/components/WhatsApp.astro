---
// Floating WhatsApp Button Component
interface Props {
  phoneNumber?: string;
  message?: string;
  position?: 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left';
  size?: 'sm' | 'md' | 'lg';
}

const { 
  phoneNumber = "5491165951634", // Replace with actual phone number
  message = "¡Hola! Me interesa más información sobre las clases de Taekwondo en Escuela Ul-ji.",
  position = "bottom-right",
  size = "md"
} = Astro.props;

// Encode the message for URL
const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;

// Position classes
const positionClasses = {
  'bottom-right': 'bottom-4 right-4',
  'bottom-left': 'bottom-6 left-6',
  'top-right': 'top-6 right-6',
  'top-left': 'top-6 left-6'
};

// Responsive size classes - mobile first approach
// Mobile (default): small, Tablet (md): medium, Desktop (lg): larger
const responsiveSizeClasses = 'w-10 h-10 md:w-12 md:h-12 lg:w-14 lg:h-14';
const responsiveIconSizes = 'w-5 h-5 md:w-6 md:h-6 lg:w-7 lg:h-7';

// Size classes (kept for backward compatibility if size prop is used)
const sizeClasses = {
  'sm': 'w-10 h-10',
  'md': 'w-12 h-12',
  'lg': 'w-16 h-16'
};

const iconSizes = {
  'sm': 'w-5 h-5',
  'md': 'w-6 h-6',
  'lg': 'w-8 h-8'
};
---

<!-- Floating WhatsApp Button -->
<div class={`fixed ${positionClasses[position]} z-50 group`}>
  <!-- Main Button -->
  <a 
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`
      ${responsiveSizeClasses}
      bg-green-500 hover:bg-green-600 
      text-white rounded-full 
      flex items-center justify-center
      shadow-lg hover:shadow-xl
      transform hover:scale-110 active:scale-95
      transition-all duration-300 ease-in-out
      relative overflow-hidden
    `}
    aria-label="Contactar por WhatsApp"
  >
    <!-- Background Animation -->
    <div class="absolute inset-0 bg-gradient-to-br from-green-400 to-green-600 rounded-full transform scale-0 group-hover:scale-100 transition-transform duration-300"></div>
    
    <!-- WhatsApp Icon -->
    <svg 
      class={`${responsiveIconSizes} relative z-10 filter drop-shadow-sm`} 
      fill="currentColor" 
      viewBox="0 0 24 24"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.484 3.488"/>
    </svg>

    <!-- Ripple Effect -->
    <div class="absolute inset-0 rounded-full bg-white opacity-0 group-active:opacity-20 group-active:animate-ping"></div>
  </a>

  <!-- Tooltip -->
  <div class={`
    absolute ${position.includes('right') ? 'right-full mr-4' : 'left-full ml-4'} 
    ${position.includes('bottom') ? 'bottom-0' : 'top-0'}
    bg-gray-900 text-white text-sm px-3 py-2 rounded-lg
    opacity-0 group-hover:opacity-100
    transform ${position.includes('right') ? 'translate-x-2' : '-translate-x-2'} group-hover:translate-x-0
    transition-all duration-300 ease-out
    pointer-events-none
    whitespace-nowrap
    shadow-lg
    before:content-[''] before:absolute 
    ${position.includes('right') ? 'before:left-full before:border-l-gray-900' : 'before:right-full before:border-r-gray-900'}
    ${position.includes('bottom') ? 'before:bottom-3' : 'before:top-3'}
    before:border-4 before:border-transparent
    before:border-solid
    z-10
  `}>
    ¡Escríbenos por WhatsApp!
  </div>

  <!-- Online Indicator -->
  <div class={`
    absolute -top-1 -right-1
    w-4 h-4 bg-green-400 border-2 border-white rounded-full
    animate-ping
  `}></div>
  <div class={`
    absolute -top-1 -right-1
    w-4 h-4 bg-green-400 border-2 border-white rounded-full
  `}></div>
</div>

<style>
  /* Custom animations */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  

  /* Enhanced shadow for better visibility */
  .group a {
    box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
  } 
  
  .group:hover a {
    box-shadow: 0 8px 30px rgba(34, 197, 94, 0.6);
  }
 
  @keyframes slideIn {
    from {
      transform: translateY(100px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  // Add click analytics or additional functionality if needed
  document.addEventListener('DOMContentLoaded', function() {
    const whatsappButton = document.querySelector('a[href*="wa.me"]');
    
    if (whatsappButton) {
      whatsappButton.addEventListener('click', function() {
        // Track WhatsApp button clicks (optional)
        console.log('WhatsApp button clicked');
        
        // You can add Google Analytics or other tracking here
        // gtag('event', 'click', { event_category: 'WhatsApp', event_label: 'Floating Button' });
      });
    }
  });
</script>