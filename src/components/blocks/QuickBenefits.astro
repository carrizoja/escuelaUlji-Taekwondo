---
// Quick Benefits component for Escuela Ul-ji Taekwondo
export interface Props {
  title?: string;
  benefits?: string[];
}

const { 
  title = "¿Por qué elegir Escuela Ul-ji?",
  benefits = [
    "Instructores certificados",
    "Clases a partir de los 6 años", 
    "Equipamiento incluido",
    "Ambiente familiar",
    "Preparación para competencias",
    "Primeras dos clases gratis"
  ]
} = Astro.props;
---

<div
  class="bg-gradient-to-br from-white to-gray-50 dark:from-gray-900 dark:to-gray-700 rounded-2xl p-8 text-gray-800 dark:text-white shadow-xl transition-colors duration-300"
>
  <h3 class="text-2xl font-bold mb-6">
    {title}
  </h3>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {benefits.map((benefit) => (
      <div class="flex items-center">
        <svg
          class="w-5 h-5 text-red-600 dark:text-red-400 mr-3 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-sm">{benefit}</span>
      </div>
    ))}
  </div>
</div>
