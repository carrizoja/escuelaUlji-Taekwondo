---
// Assistant Instructor component for Escuela Ul-ji Taekwondo
export interface Props {
  name: string;
  title: string;
  rank: string;
  experience: string;
  specialty: string;
  focus: string;
  gradientFrom: string;
  gradientTo: string;
  photo: string;
}

const {
  name,
  title,
  rank,
  experience,
  specialty,
  focus,
  gradientFrom,
  gradientTo,
  photo
} = Astro.props;

const gradientClass = `from-${gradientFrom} to-${gradientTo}`;
---

<div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden group hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
  <div class={`relative h-64 bg-gradient-to-br ${gradientClass}`}>
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-52 h-52 bg-white/10 rounded-full flex items-center justify-center backdrop-blur-sm overflow-hidden">
        {photo ? (
          <img 
            src={photo} 
            alt={`foto ${name.toLowerCase()}`}
            class="w-full h-full rounded-full"
          />
        ) : (
          <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        )}
      </div>
    </div>
    <div class="absolute top-4 right-4 bg-black/50 backdrop-blur-sm rounded-full px-3 py-1">
      <span class="text-white font-heading font-semibold text-xs">{rank}</span>
    </div>
  </div>
  
  <div class="p-6">
    <h4 class="text-xl font-heading font-bold text-gray-900 dark:text-white mb-2 transition-colors duration-300">
      {name}
    </h4>
    <p class="text-brand-red font-heading font-semibold text-sm mb-4">
      {title} • {rank}
    </p>
    <div class="space-y-2 text-sm font-text text-gray-600 dark:text-gray-400">
      <div class="flex items-center">
        <svg class="w-4 h-4 text-brand-red mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        {experience}
      </div>
      <div class="flex items-center">
        <svg class="w-4 h-4 text-brand-red mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        {specialty}
      </div>
      <div class="flex items-center">
        <svg class="w-4 h-4 text-brand-red mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        {focus}
      </div>
    </div>
  </div>
</div>
