---
// Assistant Instructor component for Escuela Ul-ji Taekwondo
export interface Props {
  name: string;
  title: string;
  rank: string;
  experience: string;
  specialty: string;
  focus: string;
  gradientFrom: string;
  gradientTo: string;
  photo: string;
  instagram?: string;
  resume?: string;
}

const {
  name,
  title,
  rank,
  experience,
  specialty,
  focus,
  gradientFrom,
  gradientTo,
  photo,
  instagram,
  resume
} = Astro.props;

const gradientClass = `from-${gradientFrom} to-${gradientTo}`;
---

<div class="bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden group hover:shadow-xl transition-all duration-500 relative">
  <!-- Bright light effect overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out z-10"></div>
  
  <div class={`relative h-64 bg-gradient-to-br ${gradientClass}`}>
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-52 h-52 bg-white/10 rounded-full flex items-center justify-center backdrop-blur-sm overflow-hidden">
        {photo ? (
          <img 
            src={photo} 
            alt={`foto ${name.toLowerCase()}`}
            class="w-full h-full rounded-full"
          />
        ) : (
          <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        )}
      </div>
    </div>
    <div class="absolute top-4 right-4 bg-black/50 backdrop-blur-sm rounded-full px-3 py-1">
      <span class="text-white font-heading font-semibold text-xs">{rank}</span>
    </div>
  </div>
  
  <div class="p-6">
    <h4 class="text-xl font-heading font-bold text-gray-900 dark:text-white mb-2 transition-colors duration-300">
      {name}
    </h4>
    <p class="text-brand-red font-heading font-semibold text-sm mb-4">
      {title} • {rank}
    </p>
    <div class="space-y-2 text-sm font-text text-gray-600 dark:text-gray-400">
      <div class="flex items-center">
        <svg class="w-4 h-4 text-brand-red mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        {experience}
      </div>
      <div class="flex items-center">
        <svg class="w-4 h-4 text-brand-red mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        {specialty}
      </div>
      <div class="flex items-center">
        <svg class="w-4 h-4 text-brand-red mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        {focus}
      </div>
    </div>
    
    <!-- Social Links and Actions -->
    <div class="mt-4 flex items-center justify-between">
      <div class="flex space-x-3">
        {instagram && (
          <a 
            href={`https://instagram.com/${instagram}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-8 h-8 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full text-white hover:from-pink-600 hover:to-purple-700 transition-all duration-300 hover:scale-110"
            aria-label={`Instagram de ${name}`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        )}
      </div>
      
      {resume && (
        <a 
          href={resume}
          download={resume}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-brand-red text-white text-xs font-semibold rounded-lg hover:bg-red-700 transition-colors duration-300"
        >
          Ver CV
        </a>
      )}
    </div>
  </div>
</div>
