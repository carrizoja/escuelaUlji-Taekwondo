---
// History component - Taekwondo timeline with milestones
import GradientLine from "../ui/GradientLine.astro";
import { taekwondoMilestones, getIcon } from "../../data/milestones.js";
import Section from "../Section.astro";
---

<!-- Historia Section -->
<Section tone="light" id="historia" class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2
        class="heading text-3xl md:text-4xl mb-6"
      >
        Historia del Taekwon-do
      </h2>
      <GradientLine />
      <p class="text-lg text-muted max-w-3xl mx-auto">
        El Taekwon-do es mucho más que un arte marcial, es una filosofía de
        vida que combina técnicas de combate con desarrollo espiritual y
        mental.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Desktop timeline line -->
      <div
        class="hidden md:block absolute left-1/2 transform -translate-x-px h-full w-1 bg-brand-red/30"
      >
      </div>
      <!-- Mobile timeline line -->
      <div
        class="md:hidden absolute left-8 h-full w-1 bg-brand-red/30"
      >
      </div>

      <div class="space-y-8 md:space-y-16">
        {
          taekwondoMilestones.map((milestone) => (
            <div class="relative">
              {/* Mobile Layout */}
              <div class="md:hidden flex items-start">
                <div class="absolute left-8 transform -translate-x-1/2 w-8 h-8 bg-ulji-red-500 rounded-full border-4 border-bg flex items-center justify-center flex-shrink-0">
                  <svg
                    class="w-4 h-4 text-white"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <Fragment set:html={getIcon(milestone.icon)} />
                  </svg>
                </div>
                <div class="ml-16 pb-8">
                  <div class="bg-card p-4 rounded-xl shadow-lg">
                    <h3 class="text-lg font-bold text-fg mb-2">
                      {milestone.title} ({milestone.year})
                    </h3>
                    <p class="text-sm text-muted">
                      {milestone.description}
                    </p>
                  </div>
                </div>
              </div>

              {/* Desktop Layout */}
              <div class="hidden md:flex items-center">
                {milestone.position === "left" ? (
                  <>
                    <div class="flex-1 pr-8 text-right">
                      <div class="bg-card p-6 rounded-xl shadow-lg">
                        <h3 class="text-xl font-bold text-fg mb-2">
                          {milestone.title} ({milestone.year})
                        </h3>
                        <p class="text-muted">
                          {milestone.description}
                        </p>
                      </div>
                    </div>
                    <div
                      class={`absolute left-1/2 transform -translate-x-1/2 w-12 h-12 bg-${milestone.color} rounded-full border-4 border-bg flex items-center justify-center`}
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <Fragment set:html={getIcon(milestone.icon)} />
                      </svg>
                    </div>
                    <div class="flex-1 pl-8" />
                  </>
                ) : (
                  <>
                    <div class="flex-1 pr-8" />
                    <div
                      class={`absolute left-1/2 transform -translate-x-1/2 w-12 h-12 bg-${milestone.color} rounded-full border-4 border-bg flex items-center justify-center`}
                    >
                      <svg
                        class="w-6 h-6 text-white"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <Fragment set:html={getIcon(milestone.icon)} />
                      </svg>
                    </div>
                    <div class="flex-1 pl-8">
                      <div class="bg-card p-6 rounded-xl shadow-lg">
                        <h3 class="text-xl font-bold text-fg mb-2">
                          {milestone.title} ({milestone.year})
                        </h3>
                        <p class="text-muted">
                          {milestone.description}
                        </p>
                      </div>
                    </div>
                  </>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>
