---
import { schoolTimeline } from '../../data/schoolTime.js';
---

<section class="mb-16">
  <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
    Historia de la Escuela
  </h3>
  
  <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-lg">
    <div class="space-y-8">
      {schoolTimeline.map((milestone) => (
        <div class="flex items-start">
          <div class={`flex-shrink-0 w-16 h-16 bg-${milestone.color}-100 dark:bg-${milestone.color}-900/30 rounded-full flex items-center justify-center mr-6`}>
            <span class={`text-${milestone.color}-600 dark:text-${milestone.color}-400 font-bold text-sm`}>
              {milestone.year}
            </span>
          </div>
          <div>
            <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
              {milestone.title}
            </h4>
            <p class="text-gray-600 dark:text-gray-400">
              {milestone.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>