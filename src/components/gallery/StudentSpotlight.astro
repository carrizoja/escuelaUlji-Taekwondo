---
// StudentSpotlight.astro - Featured student achievements and success stories
---

<section class="bg-gray-50 dark:bg-gray-800 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full mb-4">
        <svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
        </svg>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Estudiantes Destacados
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Historias de superación, dedicación y logros extraordinarios de nuestra familia Ul-ji
      </p>
    </div>

    <!-- Featured Student of the Month -->
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl overflow-hidden mb-16">
      <div class="md:flex">
        <div class="md:w-1/2">
          <img 
            src="/api/placeholder/600/400" 
            alt="Estudiante del mes"
            class="w-full h-64 md:h-full object-cover"
          />
        </div>
        <div class="md:w-1/2 p-8 md:p-12">
          <div class="flex items-center mb-4">
            <span class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 px-3 py-1 text-sm font-semibold rounded-full">
              ESTUDIANTE DEL MES
            </span>
          </div>
          
          <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
            Ana García Rodríguez
          </h3>
          
          <div class="flex items-center space-x-4 mb-6">
            <div class="text-center">
              <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center mb-2">
                <span class="text-white font-bold">2°</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Dan</p>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-red-600 dark:text-red-400">15</div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Años</p>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-red-600 dark:text-red-400">5</div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Años entrenando</p>
            </div>
          </div>

          <blockquote class="text-gray-600 dark:text-gray-400 italic mb-6">
            "El Taekwondo no solo me ha enseñado a defenderme, sino que me ha dado confianza, disciplina y una familia increíble. Cada día en Ul-ji es una oportunidad para crecer como persona."
          </blockquote>

          <div class="space-y-3">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-yellow-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Campeona Regional Sub-16 (2024)</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-yellow-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Medalla de Bronce Nacional (2023)</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-yellow-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Asistente de Instructor</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Student Success Stories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Success Story 1 -->
      <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <img 
            src="/api/placeholder/400/250" 
            alt="Carlos Mendez"
            class="w-full h-48 object-cover"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded-full">
              1° Dan
            </span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
            Carlos Méndez
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            De principiante tímido a cinturón negro en 4 años
          </p>
          
          <div class="flex items-center space-x-4 mb-4">
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">28</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">4</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">12</div>
              <p class="text-xs text-gray-500">Competencias</p>
            </div>
          </div>

          <blockquote class="text-sm italic text-gray-600 dark:text-gray-400 mb-4">
            "Llegué sin confianza en mí mismo. Hoy soy instructor y he encontrado mi pasión."
          </blockquote>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Instructor Certificado</span>
            </div>
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">3x Medalla de Oro Regional</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Success Story 2 -->
      <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <img 
            src="/api/placeholder/400/250" 
            alt="Sofia Martinez"
            class="w-full h-48 object-cover"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded-full">
              3° Dan
            </span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
            Sofía Martínez
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            Superando límites desde los 8 años
          </p>
          
          <div class="flex items-center space-x-4 mb-4">
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">16</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">8</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">25</div>
              <p class="text-xs text-gray-500">Medallas</p>
            </div>
          </div>

          <blockquote class="text-sm italic text-gray-600 dark:text-gray-400 mb-4">
            "El Taekwondo me enseñó que no hay límites cuando tienes determinación."
          </blockquote>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Campeona Nacional Sub-18</span>
            </div>
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Beca Deportiva Universitaria</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Success Story 3 -->
      <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <img 
            src="/api/placeholder/400/250" 
            alt="Familia Rodriguez"
            class="w-full h-48 object-cover"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded-full">
              Familia
            </span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
            Familia Rodríguez
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            Tres generaciones practicando juntas
          </p>
          
          <div class="flex items-center space-x-4 mb-4">
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">5</div>
              <p class="text-xs text-gray-500">Miembros</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">6</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">15</div>
              <p class="text-xs text-gray-500">Cinturones</p>
            </div>
          </div>

          <blockquote class="text-sm italic text-gray-600 dark:text-gray-400 mb-4">
            "Una actividad que nos unió como familia y nos enseñó valores para toda la vida."
          </blockquote>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Familia del Año 2023</span>
            </div>
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Participación en Exhibiciones</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Success Story 4 -->
      <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <img 
            src="/api/placeholder/400/250" 
            alt="Miguel Torres"
            class="w-full h-48 object-cover"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded-full">
              2° Dan
            </span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
            Miguel Torres
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            Atleta paralímpico, ejemplo de superación
          </p>
          
          <div class="flex items-center space-x-4 mb-4">
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">24</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">3</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">8</div>
              <p class="text-xs text-gray-500">Medallas</p>
            </div>
          </div>

          <blockquote class="text-sm italic text-gray-600 dark:text-gray-400 mb-4">
            "El Taekwondo adaptado me devolvió la confianza y me abrió un mundo de posibilidades."
          </blockquote>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Clasificado Paralímpicos</span>
            </div>
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Embajador de Inclusión</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Success Story 5 -->
      <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <img 
            src="/api/placeholder/400/250" 
            alt="Emma Wilson"
            class="w-full h-48 object-cover"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded-full">
              1° Dan
            </span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
            Emma Wilson
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            Intercambio cultural: De Canadá a Ul-ji
          </p>
          
          <div class="flex items-center space-x-4 mb-4">
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">22</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">2</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">5</div>
              <p class="text-xs text-gray-500">Países</p>
            </div>
          </div>

          <blockquote class="text-sm italic text-gray-600 dark:text-gray-400 mb-4">
            "Encontré en Ul-ji no solo técnicas superiores, sino una filosofía de vida auténtica."
          </blockquote>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Campeona Internacional</span>
            </div>
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700 dark:text-gray-300">Profesora de Intercambio</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Success Story 6 -->
      <div class="bg-white dark:bg-gray-900 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <img 
            src="/api/placeholder/400/250" 
            alt="Pedro Sanchez"
            class="w-full h-48 object-cover"
          />
          <div class="absolute top-4 left-4">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded-full">
              4° Dan
            </span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
            Pedro Sánchez
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
            De alumno a maestro: 15 años de dedicación
          </p>
          
          <div class="flex items-center space-x-4 mb-4">
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">35</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">15</div>
              <p class="text-xs text-gray-500">Años</p>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-red-600 dark:text-red-400">50+</div>
              <p class="text-xs text-gray-500">Estudiantes</p>
            </div>
          </div>

          <blockquote class="text-sm italic text-gray-600 dark:text-gray-400 mb-4">
            "De ser un estudiante nervioso a formar la próxima generación de campeones."
          </blockquote>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
