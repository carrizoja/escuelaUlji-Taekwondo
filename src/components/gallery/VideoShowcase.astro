---
// VideoShowcase.astro - Video gallery section
---

<section class="bg-white dark:bg-gray-900 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full mb-4">
        <svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Videos Destacados
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Momentos únicos, técnicas magistrales y logros extraordinarios de nuestra escuela
      </p>
    </div>

    <!-- Featured Video -->
    <div class="mb-16">
      <div class="relative bg-gray-900 rounded-2xl overflow-hidden shadow-2xl">
        <div class="aspect-w-16 aspect-h-9">
          <div class="relative group cursor-pointer">
            <img 
              src="/api/placeholder/1200/675" 
              alt="Video destacado de Taekwondo"
              class="w-full h-full object-cover"
            />
            
            <!-- Play Button Overlay -->
            <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center group-hover:bg-opacity-60 transition-all duration-300">
              <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300 shadow-lg">
                <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                </svg>
              </div>
            </div>

            <!-- Video Info Overlay -->
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black to-transparent p-6 text-white">
              <div class="flex items-center space-x-2 mb-2">
                <span class="bg-red-600 px-2 py-1 text-xs font-semibold rounded">DESTACADO</span>
                <span class="text-sm text-gray-300">5:24</span>
              </div>
              <h3 class="text-xl md:text-2xl font-bold mb-2">Campeonato Nacional 2024 - Final</h3>
              <p class="text-gray-300 text-sm md:text-base">Momentos más emocionantes de la final del Campeonato Nacional</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Video Categories -->
    <div class="mb-12">
      <div class="flex flex-wrap justify-center gap-4">
        <button class="bg-red-600 text-white px-6 py-2 rounded-full font-medium">
          Todos
        </button>
        <button class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-gray-700 px-6 py-2 rounded-full font-medium transition-colors duration-300">
          Competencias
        </button>
        <button class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-gray-700 px-6 py-2 rounded-full font-medium transition-colors duration-300">
          Técnicas
        </button>
        <button class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-gray-700 px-6 py-2 rounded-full font-medium transition-colors duration-300">
          Entrenamientos
        </button>
        <button class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-gray-700 px-6 py-2 rounded-full font-medium transition-colors duration-300">
          Testimonios
        </button>
      </div>
    </div>

    <!-- Video Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Video Card 1 -->
      <div class="group bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <div class="aspect-w-16 aspect-h-9">
            <img 
              src="/api/placeholder/400/225" 
              alt="Técnicas de patadas básicas"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          
          <!-- Play Button -->
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 flex items-center justify-center transition-all duration-300">
            <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>

          <!-- Duration Badge -->
          <div class="absolute bottom-2 right-2">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded">3:45</span>
          </div>

          <!-- Category Badge -->
          <div class="absolute top-2 left-2">
            <span class="bg-blue-600 text-white px-2 py-1 text-xs font-semibold rounded">TÉCNICAS</span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">
            Técnicas de Patadas Básicas
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
            Aprende las patadas fundamentales del Taekwondo con nuestro instructor principal
          </p>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
            <span>1.2K visualizaciones</span>
            <span>Hace 2 días</span>
          </div>
        </div>
      </div>

      <!-- Video Card 2 -->
      <div class="group bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <div class="aspect-w-16 aspect-h-9">
            <img 
              src="/api/placeholder/400/225" 
              alt="Combate de sparring"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 flex items-center justify-center transition-all duration-300">
            <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-2 right-2">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded">8:12</span>
          </div>

          <div class="absolute top-2 left-2">
            <span class="bg-yellow-600 text-white px-2 py-1 text-xs font-semibold rounded">COMPETENCIA</span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">
            Combate de Sparring Avanzado
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
            Observa las técnicas avanzadas en un combate real entre nuestros estudiantes
          </p>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
            <span>2.8K visualizaciones</span>
            <span>Hace 1 semana</span>
          </div>
        </div>
      </div>

      <!-- Video Card 3 -->
      <div class="group bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <div class="aspect-w-16 aspect-h-9">
            <img 
              src="/api/placeholder/400/225" 
              alt="Examen de grado"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 flex items-center justify-center transition-all duration-300">
            <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-2 right-2">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded">6:30</span>
          </div>

          <div class="absolute top-2 left-2">
            <span class="bg-purple-600 text-white px-2 py-1 text-xs font-semibold rounded">EXAMEN</span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">
            Examen de Grado - Cinturón Negro
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
            Ceremonia de ascenso a cinturón negro - Un momento histórico para nuestros estudiantes
          </p>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
            <span>5.1K visualizaciones</span>
            <span>Hace 2 semanas</span>
          </div>
        </div>
      </div>

      <!-- Video Card 4 -->
      <div class="group bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <div class="aspect-w-16 aspect-h-9">
            <img 
              src="/api/placeholder/400/225" 
              alt="Testimonio de estudiante"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 flex items-center justify-center transition-all duration-300">
            <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-2 right-2">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded">2:15</span>
          </div>

          <div class="absolute top-2 left-2">
            <span class="bg-green-600 text-white px-2 py-1 text-xs font-semibold rounded">TESTIMONIO</span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">
            "Mi Experiencia en Ul-ji"
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
            María nos cuenta cómo el Taekwondo cambió su vida y la de su familia
          </p>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
            <span>950 visualizaciones</span>
            <span>Hace 3 días</span>
          </div>
        </div>
      </div>

      <!-- Video Card 5 -->
      <div class="group bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <div class="aspect-w-16 aspect-h-9">
            <img 
              src="/api/placeholder/400/225" 
              alt="Entrenamiento infantil"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 flex items-center justify-center transition-all duration-300">
            <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-2 right-2">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded">4:20</span>
          </div>

          <div class="absolute top-2 left-2">
            <span class="bg-orange-600 text-white px-2 py-1 text-xs font-semibold rounded">INFANTIL</span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">
            Clase de Niños - Diversión y Disciplina
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
            Mira cómo nuestros pequeños guerreros aprenden mientras se divierten
          </p>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
            <span>1.8K visualizaciones</span>
            <span>Hace 5 días</span>
          </div>
        </div>
      </div>

      <!-- Video Card 6 -->
      <div class="group bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="relative">
          <div class="aspect-w-16 aspect-h-9">
            <img 
              src="/api/placeholder/400/225" 
              alt="Demostración de formas"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 flex items-center justify-center transition-all duration-300">
            <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
              <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-2 right-2">
            <span class="bg-black bg-opacity-75 text-white px-2 py-1 text-xs rounded">7:45</span>
          </div>

          <div class="absolute top-2 left-2">
            <span class="bg-indigo-600 text-white px-2 py-1 text-xs font-semibold rounded">POOMSAE</span>
          </div>
        </div>
        
        <div class="p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white text-lg mb-2 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors duration-300">
            Poomsae Taegeuk - Formas Tradicionales
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">
            Demostración perfecta de las formas tradicionales del Taekwondo WTF
          </p>
          <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
            <span>3.2K visualizaciones</span>
            <span>Hace 1 mes</span>
          </div>
        </div>
      </div>
    </div>

    <!-- View All Videos Button -->
    <div class="text-center mt-12">
      <a 
        href="#all-videos" 
        class="inline-flex items-center bg-red-600 hover:bg-red-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors duration-300"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        Ver Todos los Videos
      </a>
    </div>
  </div>
</section>
