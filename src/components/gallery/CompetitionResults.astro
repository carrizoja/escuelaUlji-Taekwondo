---
// CompetitionResults.astro - Competition achievements and tournament results
---

<section class="bg-white dark:bg-gray-900 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-yellow-100 dark:bg-yellow-900/30 rounded-full mb-4">
        <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
        </svg>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Resultados de Competencias
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Nuestros logros en torneos nacionales e internacionales que demuestran la excelencia de Ul-ji
      </p>
    </div>

    <!-- Overall Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
      <div class="text-center bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-xl p-6 text-white">
        <div class="text-4xl font-bold mb-2">127</div>
        <div class="text-yellow-100 text-sm font-medium">Medallas de Oro</div>
      </div>
      <div class="text-center bg-gradient-to-br from-gray-300 to-gray-500 rounded-xl p-6 text-white">
        <div class="text-4xl font-bold mb-2">89</div>
        <div class="text-gray-100 text-sm font-medium">Medallas de Plata</div>
      </div>
      <div class="text-center bg-gradient-to-br from-amber-600 to-amber-800 rounded-xl p-6 text-white">
        <div class="text-4xl font-bold mb-2">156</div>
        <div class="text-amber-100 text-sm font-medium">Medallas de Bronce</div>
      </div>
      <div class="text-center bg-gradient-to-br from-red-500 to-red-700 rounded-xl p-6 text-white">
        <div class="text-4xl font-bold mb-2">45</div>
        <div class="text-red-100 text-sm font-medium">Campeonatos</div>
      </div>
    </div>

    <!-- Recent Competitions -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
        Competencias Recientes - 2024
      </h3>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Competition 1 -->
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-8 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-yellow-400 to-yellow-600"></div>
          
          <div class="flex items-start justify-between mb-6">
            <div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                Campeonato Nacional de España 2024
              </h4>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Madrid • 15-17 Marzo 2024
              </p>
            </div>
            <div class="flex items-center bg-yellow-100 dark:bg-yellow-900/30 px-3 py-1 rounded-full">
              <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              <span class="text-yellow-700 dark:text-yellow-300 text-xs font-semibold">NACIONAL</span>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-4 mb-6">
            <div class="text-center">
              <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="text-white font-bold text-lg">5</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Oro</p>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-gray-400 rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="text-white font-bold text-lg">3</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Plata</p>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-amber-600 rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="text-white font-bold text-lg">7</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Bronce</p>
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
              <span class="text-gray-700 dark:text-gray-300">Ana García - 1° Lugar Senior Femenino</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
              <span class="text-gray-700 dark:text-gray-300">Carlos Méndez - 1° Lugar Senior Masculino</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-3 h-3 bg-gray-400 rounded-full mr-3"></div>
              <span class="text-gray-700 dark:text-gray-300">Sofía Martínez - 2° Lugar Junior Femenino</span>
            </div>
          </div>
        </div>

        <!-- Competition 2 -->
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-8 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-red-500 to-red-700"></div>
          
          <div class="flex items-start justify-between mb-6">
            <div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                Copa Internacional de Europa
              </h4>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                París, Francia • 8-10 Junio 2024
              </p>
            </div>
            <div class="flex items-center bg-red-100 dark:bg-red-900/30 px-3 py-1 rounded-full">
              <svg class="w-4 h-4 text-red-600 dark:text-red-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-red-700 dark:text-red-300 text-xs font-semibold">INTERNACIONAL</span>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-4 mb-6">
            <div class="text-center">
              <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="text-white font-bold text-lg">3</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Oro</p>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-gray-400 rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="text-white font-bold text-lg">4</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Plata</p>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-amber-600 rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="text-white font-bold text-lg">2</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-400">Bronce</p>
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center text-sm">
              <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
              <span class="text-gray-700 dark:text-gray-300">Emma Wilson - 1° Lugar Open Internacional</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-3 h-3 bg-gray-400 rounded-full mr-3"></div>
              <span class="text-gray-700 dark:text-gray-300">Miguel Torres - 2° Lugar Adaptado</span>
            </div>
            <div class="flex items-center text-sm">
              <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
              <span class="text-gray-700 dark:text-gray-300">Equipo Ul-ji - 1° Lugar por Equipos</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Competition Timeline -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
        Cronología de Éxitos
      </h3>
      
      <div class="relative">
        <!-- Timeline Line -->
        <div class="absolute left-1/2 transform -translate-x-px h-full w-0.5 bg-gray-300 dark:bg-gray-600"></div>
        
        <div class="space-y-12">
          <!-- 2024 -->
          <div class="relative flex items-center">
            <div class="flex-1 text-right pr-8">
              <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg">
                <h4 class="font-bold text-gray-900 dark:text-white mb-2">2024</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                  Año récord con 15 medallas de oro en competencias nacionales
                </p>
                <div class="flex justify-end space-x-2">
                  <span class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 px-2 py-1 rounded text-xs">15 Oro</span>
                  <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 px-2 py-1 rounded text-xs">9 Plata</span>
                  <span class="bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400 px-2 py-1 rounded text-xs">12 Bronce</span>
                </div>
              </div>
            </div>
            <div class="relative z-10 w-8 h-8 bg-red-600 rounded-full border-4 border-white dark:border-gray-900 flex items-center justify-center">
              <div class="w-3 h-3 bg-white rounded-full"></div>
            </div>
            <div class="flex-1 pl-8"></div>
          </div>

          <!-- 2023 -->
          <div class="relative flex items-center">
            <div class="flex-1 pr-8"></div>
            <div class="relative z-10 w-8 h-8 bg-red-600 rounded-full border-4 border-white dark:border-gray-900 flex items-center justify-center">
              <div class="w-3 h-3 bg-white rounded-full"></div>
            </div>
            <div class="flex-1 text-left pl-8">
              <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg">
                <h4 class="font-bold text-gray-900 dark:text-white mb-2">2023</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                  Primera participación internacional con excelentes resultados
                </p>
                <div class="flex space-x-2">
                  <span class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 px-2 py-1 rounded text-xs">8 Oro</span>
                  <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 px-2 py-1 rounded text-xs">12 Plata</span>
                  <span class="bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400 px-2 py-1 rounded text-xs">15 Bronce</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 2022 -->
          <div class="relative flex items-center">
            <div class="flex-1 text-right pr-8">
              <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg">
                <h4 class="font-bold text-gray-900 dark:text-white mb-2">2022</h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                  Consolidación como una de las mejores escuelas del país
                </p>
                <div class="flex justify-end space-x-2">
                  <span class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-400 px-2 py-1 rounded text-xs">12 Oro</span>
                  <span class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300 px-2 py-1 rounded text-xs">10 Plata</span>
                  <span class="bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400 px-2 py-1 rounded text-xs">18 Bronce</span>
                </div>
              </div>
            </div>
            <div class="relative z-10 w-8 h-8 bg-red-600 rounded-full border-4 border-white dark:border-gray-900 flex items-center justify-center">
              <div class="w-3 h-3 bg-white rounded-full"></div>
            </div>
            <div class="flex-1 pl-8"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Competitors -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">
        Nuestros Campeones
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Champion 1 -->
        <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 dark:from-yellow-900/20 dark:to-yellow-800/20 rounded-xl p-6 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-20 h-20 bg-yellow-300 dark:bg-yellow-600 rounded-full -translate-y-10 translate-x-10 opacity-20"></div>
          <img 
            src="/api/placeholder/80/80" 
            alt="Ana García"
            class="w-20 h-20 rounded-full mx-auto mb-4 border-4 border-yellow-400"
          />
          <h4 class="font-bold text-gray-900 dark:text-white mb-2">Ana García</h4>
          <p class="text-yellow-700 dark:text-yellow-400 text-sm font-semibold mb-3">Campeona Nacional 2024</p>
          <div class="flex justify-center space-x-4 text-xs">
            <div class="text-center">
              <div class="font-bold text-yellow-600 dark:text-yellow-400">15</div>
              <div class="text-gray-600 dark:text-gray-400">Oro</div>
            </div>
            <div class="text-center">
              <div class="font-bold text-gray-500">8</div>
              <div class="text-gray-600 dark:text-gray-400">Plata</div>
            </div>
            <div class="text-center">
              <div class="font-bold text-amber-600">3</div>
              <div class="text-gray-600 dark:text-gray-400">Bronce</div>
            </div>
          </div>
        </div>

        <!-- Champion 2 -->
        <div class="bg-gradient-to-br from-red-50 to-red-100 dark:from-red-900/20 dark:to-red-800/20 rounded-xl p-6 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-20 h-20 bg-red-300 dark:bg-red-600 rounded-full -translate-y-10 translate-x-10 opacity-20"></div>
          <img 
            src="/api/placeholder/80/80" 
            alt="Carlos Méndez"
            class="w-20 h-20 rounded-full mx-auto mb-4 border-4 border-red-400"
          />
          <h4 class="font-bold text-gray-900 dark:text-white mb-2">Carlos Méndez</h4>
          <p class="text-red-700 dark:text-red-400 text-sm font-semibold mb-3">Campeón Internacional</p>
          <div class="flex justify-center space-x-4 text-xs">
            <div class="text-center">
              <div class="font-bold text-yellow-600 dark:text-yellow-400">12</div>
              <div class="text-gray-600 dark:text-gray-400">Oro</div>
            </div>
            <div class="text-center">
              <div class="font-bold text-gray-500">10</div>
              <div class="text-gray-600 dark:text-gray-400">Plata</div>
            </div>
            <div class="text-center">
              <div class="font-bold text-amber-600">7</div>
              <div class="text-gray-600 dark:text-gray-400">Bronce</div>
            </div>
          </div>
        </div>

        <!-- Champion 3 -->
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 rounded-xl p-6 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-20 h-20 bg-purple-300 dark:bg-purple-600 rounded-full -translate-y-10 translate-x-10 opacity-20"></div>
          <img 
            src="/api/placeholder/80/80" 
            alt="Sofía Martínez"
            class="w-20 h-20 rounded-full mx-auto mb-4 border-4 border-purple-400"
          />
          <h4 class="font-bold text-gray-900 dark:text-white mb-2">Sofía Martínez</h4>
          <p class="text-purple-700 dark:text-purple-400 text-sm font-semibold mb-3">Promesa del Año</p>
          <div class="flex justify-center space-x-4 text-xs">
            <div class="text-center">
              <div class="font-bold text-yellow-600 dark:text-yellow-400">8</div>
              <div class="text-gray-600 dark:text-gray-400">Oro</div>
            </div>
            <div class="text-center">
              <div class="font-bold text-gray-500">12</div>
              <div class="text-gray-600 dark:text-gray-400">Plata</div>
            </div>
            <div class="text-center">
              <div class="font-bold text-amber-600">5</div>
              <div class="text-gray-600 dark:text-gray-400">Bronce</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center bg-gradient-to-r from-red-600 to-red-700 rounded-2xl p-12 text-white">
      <h3 class="text-3xl font-bold mb-4">¿Listo para ser el próximo campeón?</h3>
      <p class="text-red-100 mb-8 max-w-2xl mx-auto">
        Únete a nuestro equipo de competencia y descubre tu potencial. Con la guía adecuada y dedicación, tú podrías ser nuestro próximo campeón nacional.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="#contact" 
          class="bg-white text-red-600 hover:bg-gray-100 px-8 py-3 rounded-lg font-semibold transition-colors duration-300 inline-flex items-center justify-center"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Entrenar para Competir
        </a>
        <a 
          href="/#horarios" 
          class="bg-transparent border-2 border-white text-white hover:bg-white hover:text-red-600 px-8 py-3 rounded-lg font-semibold transition-all duration-300 inline-flex items-center justify-center"
        >
          Ver Horarios de Competencia
        </a>
      </div>
    </div>
  </div>
</section>
