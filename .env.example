# Google Sheets Configuration
# Replace with your actual Google Sheet ID and API key

# Your Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Google API Key (optional - for more reliable access)
# Get from: https://console.developers.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Public Environment Variables (will be available in the browser)
PUBLIC_GOOGLE_SHEETS_ID=your_google_sheet_id_here
